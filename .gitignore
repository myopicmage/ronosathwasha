.direnv/
result
result-*

# Machine-local permission grants. `.claude/settings.json` is shared and does
# get committed.
.claude/settings.local.json

__pycache__/
*.py[cod]

# Build output. Sources are the UFOs and the feature files; binaries are
# regenerated by fontmake and never committed.
build/
*.ttf
*.otf
*.woff2

# fontmake writes here; the UFO in sources/ is what's tracked.
!sources/*.ufo

# The project-local Raku module repository. zef fills it from META6.json, which
# is the tracked declaration; this is the installed copy.
.raku/

# Raku precompilation cache.
.precomp/
