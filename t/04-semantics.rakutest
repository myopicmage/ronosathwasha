use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Semantics;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Words;

plan 31;

my IO::Path $data = repository-root.add('data');

my $corpus     = load-utterances($data.add('utterances.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));

isa-ok $corpus, Coverage, 'the corpus parses into typed meaning';

is $corpus.utterances.elems, 33, 'thirty-three utterances';
is $corpus.coordinations.elems, 1, 'one utterance coordinates complete clauses';

my %counts = $corpus.counts;
is %counts<Attested>, 17, 'seventeen attested: the page, plus the three Kevin wrote on 2026-07-29';
nok %counts<Derived>, 'nothing left unread';
is %counts<Reviewed>, 15,
    'fifteen reviewed, including the coordinated fire-home threat';

# The status exists for a sentence the rules permit and a speaker declines, and
# these are the first two anybody has written down. They fail differently, which is
# why both are worth keeping.
#
# `Lari miriswemedi.` predicates being a teaching rather than doing any teaching:
# the construction itself is the problem.
#
# `Lari mirireme.` verbs the noun, which is a capability worth having, and picks the
# wrong noun for it: `mirire` is `miri` plus `re`, so verbing it lands next to
# `mirime` from the verb it was built from. Two routes to one meaning.
is %counts<Rejected>, 2, 'and two rejected, failing in different ways';

my $threat = $corpus.coordinations.head;
isa-ok $threat, CoordinatedUtterance, 'the threat has a typed coordination declaration';
is-deeply $threat.connectors.List, ('luru',), 'its connector keeps its lexical identity';
is-deeply $threat.clauses.map(*.predicate).List, ('thəta', 'thwa'),
    'both clause predicates are stated independently';

# ------------------------------------------------------------ meaning is typed ---

my $question = $corpus.utterances.first(*.text eq 'Nari tethinəme?');
is $question.speech-act, Interrogative, 'the question is interrogative';
is $question.tense, Present, 'in the present';
is $question.shape, SubjectOnly, 'with a subject and no object';

# ------------------------------------------------------- a question has a scope ---
#
# `to-`/`te-` attaches to whichever constituent is being asked about, so a type
# that records only "this is a question" cannot rebuild the sentence: it knows a
# marker was written and not which word carried it.

is $question.question-scope, QuestionsPredicate,
    'and says that the verb is what it asks about';
is $question.question-kind, OpenQuestion,
    'an existing interrogative defaults to an open question';

my $selective = Utterance.new(
    :text('x'), :english('x'), :status(Reviewed), :speech-act(Interrogative),
    :question-scope(QuestionsSubject), :question-kind(SelectiveQuestion),
    :predicate('thinə'), :aspect(Simple), :polarity(Affirmative), :modality(Asserted),
);
is $selective.question-kind, SelectiveQuestion,
    'a selective question preserves the explicitly chosen kind';

is-deeply $corpus.utterances.grep(*.speech-act != Interrogative)
    .map(*.question-scope).unique.List, (QuestionScope,),
    'nothing that is not a question carries a scope';

# The invariant, from both sides. A comment saying the two fields must agree is
# what `023` objected to; this is the pair being unable to disagree.
throws-like { Utterance.new(
    :text('x'), :english('x'), :status(Attested), :speech-act(Interrogative),
    :predicate('thinə'), :aspect(Simple), :polarity(Affirmative), :modality(Asserted),
) }, X::Ronosathwasha::Meaning::ScopeDisagrees,
    'an interrogative with no scope is refused',
    message => /'must say which constituent'/;

throws-like { Utterance.new(
    :text('x'), :english('x'), :status(Attested), :speech-act(Declarative),
    :predicate('thinə'), :aspect(Simple), :polarity(Affirmative), :modality(Asserted),
    :question-scope(QuestionsSubject),
) }, X::Ronosathwasha::Meaning::ScopeDisagrees,
    'and so is a scope on something that asks nothing';

throws-like { Utterance.new(
    :text('x'), :english('x'), :status(Attested), :speech-act(Declarative),
    :predicate('thinə'), :aspect(Simple), :polarity(Affirmative), :modality(Asserted),
    :question-kind(SelectiveQuestion),
) }, X::Ronosathwasha::Meaning::QuestionKindDisagrees,
    'a non-question cannot carry a question kind';

# ------------------------------------------- the fifth scope enters the corpus ---
#
# Review 026: the reader could derive the fallback scope and the declarative
# source could not state it, so the exact sentence that justified widening the
# enum, `Toro thinəme?`, was unrecordable. Synthetic rather than a real corpus
# entry, because whether that sentence belongs in `data/utterances.toml` is
# Kevin's call and the loader's vocabulary is this file's.

my IO::Path $scratch = $*TMPDIR.add("ronosathwasha-scope-{ $*PID }.toml");
LEAVE $scratch.unlink;

sub corpus-with(Str:D $questioned --> IO::Path) {
    $scratch.spurt: qq:to/TOML/;
        schema_version = 1

        [[utterance]]
        text = "Toro thinəme?"
        english = "who eats?"
        status = "derived"
        speech_act = "interrogative"
        predicate = "thinə"
        tense = "present"
        aspect = "simple"
        polarity = "affirmative"
        modality = "asserted"
        questioned = "$questioned"
        TOML

    $scratch;
}

is load-utterances(corpus-with('unmarked-constituent')).utterances.head.question-scope,
    QuestionsUnmarkedConstituent,
    'an utterance may state that its question marks an unmarked word';

nok load-utterances(corpus-with('constituent')).defined,
    'while the old bare name is not in the vocabulary';

my $teaching = $corpus.utterances.first(*.text eq 'Mirireri layi mirimedi.');
is $teaching.shape, Transitive, 'subject and object make a transitive shape';
is $teaching.aspect, Continuous, 'and the continuous marker is read as aspect';

# --------------------------------------------------- derivation is disciplined ---
#
# A derived sentence may only recombine what is already declared. This checks the
# claim rather than trusting the comment: every predicate is either a listed stem,
# a verb root recovered from its infinitive, or a compound the word parser divides.

my Set $known = $lexicon.entries.map(*.roman).Set;

my @unknown = $corpus.predicates.grep({
    not ($known{$_} or $known{"{$_}swe"} or $known{"{$_}swo"}
        or parse-word($lexicon, $morphology, $_).defined)
});

is-deeply @unknown.List, (),
    'every predicate is composed entirely from declared lexical material';

# Anything Kevin did not write himself, which is `derived`, `reviewed` and
# `rejected` alike. Keyed on "not attested" rather than on `Derived`, because that
# check emptied itself the moment eleven sentences were promoted to `reviewed`: a
# reviewed sentence was still derived from something and still has to say what.
my @composed = $corpus.utterances.grep(*.status != Attested);

is-deeply @composed.grep({ not .derived-from.defined }).map(*.text).List, (),
    'every composed sentence names the one it came from';

is-deeply @composed.grep({ not .derivation.defined }).map(*.text).List, (),
    'and says which morpheme was substituted';

ok $corpus.utterances.grep(*.status == Attested).all.source.defined,
    'every attested sentence names where Kevin wrote it';

# ------------------------------------------------------------- the stop 10 gate ---

# The `predication: Timeless` line asserted here from the moment it was added until
# `Lari mirireswe.` arrived. It needed three things that were not true at once: an
# optional tense in the corpus schema, a realizer that emits no tense morpheme
# rather than defaulting to present, and a `nominal_predicate` field so this file
# could say a copularizer was there at all. The last was found by `t/09` building
# `mirimedi` for a copular sentence.
is-deeply $corpus.missing.List, (),
    'the corpus reaches every stratum the model-selection gate requires';

ok $corpus.has-locative, 'including one locative';

# And on evidence alone, which is the question that matters. A gate satisfied by
# sentences nobody has read is satisfied on paper.
#
# This asserted three missing strata until 2026-07-29: proximal reference, past
# and future reached the floor only through derived sentences. Kevin wrote three
# about dogs and closed it, which is also how the corpus got its first attested
# back-harmonic predicate.
#
# It went short again by one when decision 22 added nominal predication, since that
# reached the corpus only through derived sentences. Kevin read all eleven on
# 2026-07-30 and accepted them, which closed it and also emptied `derived` entirely:
# every sentence here is now either evidence or a recorded refusal.
is-deeply $corpus.missing-from-evidence.List, (),
    'and on evidence alone as well, which is the only way it counts';
