use Test;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Config;
use Ronosathwasha::ConversationState;
use Ronosathwasha::Intent;
use Ronosathwasha::Lexicon;
use Ronosathwasha::ModelProtocol;
use Ronosathwasha::Morphology;
use Ronosathwasha::Prompt;
use Ronosathwasha::PromptContext;
use Ronosathwasha::Semantics;

plan 37;

my IO::Path $data = repository-root.add('data');
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));
my $config     = load-config(repository-root.add('config/chatbot.toml'));

my %schema = response-schema($lexicon, $morphology);
my %v = answer-vocabulary();

# ------------------------------------------------- a discriminated union ---
#
# One flat object with everything optional let the model omit five of six fields on the
# first live run, and the decoder allowed it because nothing was required. A branch per
# kind is what makes that omission unrepresentable rather than merely rejected.

ok %schema<oneOf>:exists, 'the schema is a union rather than one flat object';
is %schema<oneOf>.elems, %v<kind>.elems, 'with one branch per kind the decoder accepts';

# Keyed by the tag rather than by position, so nothing here depends on the order
# `answer-vocabulary` happens to list the kinds in.
my %branch = %schema<oneOf>.map({ $_<properties><kind><const> => $_ }).Hash;

is-deeply %branch.keys.sort.List, %v<kind>.sort.List,
    'and each branch tagged with a `const`, which is what discriminates them';

my %express = %branch<express>;
my %gap     = %branch<gap>;

# --------------------------------------------- the vocabulary cannot drift ---
#
# The whole reason `answer-vocabulary` is exported. Every string the schema permits
# must be a string `intent-from` accepts, and the failure this prevents is the one
# `Morphology` already had: an enum grows, the table beside it does not, and the
# symptom is a type check about the wrong thing.
#
# `kind` is excluded because it is no longer an enumeration anywhere: it is a `const`
# per branch, asserted above.

for %v.keys.grep(* ne 'kind').sort -> $field {
    my @from-schema = $field eq 'role'
        ?? %express<properties><arguments><items><properties><role><enum>.List
        !! %express<properties>{$field}<enum>.List;

    # `.List` on both sides. `is-deeply` distinguishes an Array from a List, and
    # binding to an `@` variable coerces, so comparing them bare fails on the
    # container while reporting values that look identical.
    is-deeply @from-schema.List, %v{$field}.List,
        "the schema's $field enumerates exactly what the decoder accepts";
}

# ------------------------------------ the predicate is a list, not a string ---

ok %express<properties><predicate><enum>:exists,
    'the predicate is enumerated rather than a free string';

my Set $known = nameable($lexicon, $morphology);
is %express<properties><predicate><enum>.elems, $known.elems,
    'and enumerates every nameable stem';

is-deeply %express<properties><predicate><enum>.List, $known.keys.sort.List,
    'sorted, so the schema is stable between runs';

nok %express<properties><predicate><enum>.grep('thinu'),
    'a word the lexicon does not have is not offered';
ok %express<properties><predicate><enum>.grep('thinə'),
    'while one it does have is';

# Arguments carry stems too, and the same constraint has to reach them or a model can
# invent a word in the one place nobody checked.
is-deeply %express<properties><arguments><items><properties><stem><enum>.List,
    $known.keys.sort.List, 'argument stems are constrained the same way';

# ---------------------------------------------------- refusing extra fields ---

nok %express<additionalProperties>, 'a field nobody asked for is refused';
nok %gap<additionalProperties>, 'in either branch';
nok %express<properties><arguments><items><additionalProperties>,
    'including inside an argument';

# The point of the union: neither branch can borrow the other's fields, so a half-formed
# answer is not a shape the grammar can reach.
nok %express<properties><wanted>:exists, 'an express has no gap fields to fill in';
nok %gap<properties><predicate>:exists, 'and a gap cannot name a predicate';

# --------------------------------------------- what each branch demands ---
#
# Not a judgement call. These are exactly the fields whose absence already kills
# `intent-from`: four go through `pick`, which dies on an absent value, and `predicate`
# is checked against `nameable`.

is-deeply %express<required>.sort.List,
    <aspect kind modality polarity predicate speech_act>.List,
    'an express must carry everything intent-from will demand of it';

is-deeply %gap<required>.sort.List, <kind missing wanted>.List,
    'and a gap must say both what it wanted and what is missing';

# Three stay optional, each because it has a real default rather than because nobody
# got round to requiring it.
for <tense nominal_predicate arguments> -> $field {
    nok %express<required>.grep($field),
        "$field stays optional, since intent-from supplies a default for it";
}

is %gap<properties><wanted><type>, 'string',
    'a gap is free text, since it is about what the declarations cannot express';

# --------------------------------------------------------------- the request ---

my $ctx = PromptContext.new(
    :schema(PromptInvariant.new(:label('response schema'), :text('kind express or gap'))),
    :capabilities(PromptInvariant.new(:label('language capabilities'), :text('three tenses'))),
    :state(ConversationState.new.said(Human, 'Lari thinəme.')),
);

my %body = request-body($config, $lexicon, $morphology, wire-messages($config, $ctx));

is %body<messages>.elems, 2, 'the body carries the message list';
is %body<messages>[0]<role>, 'system', 'in the protocol\'s spelling';
is %body<temperature>, 0.7, 'with the configured sampling';
is %body<top_k>, 20, 'all of it';

is %body<max_tokens>, $config.budget.reserved,
    'and max_tokens is the reservation, which is the other half of Budget\'s promise';

nok %body<chat_template_kwargs><enable_thinking>,
    'thinking is off, because those tokens come out of the same window';

is %body<response_format><type>, 'json_schema', 'the answer is schema-constrained';
ok %body<response_format><json_schema><strict>, 'strictly';
is-deeply %body<response_format><json_schema><schema>, %schema,
    'against the schema built from the declarations';

# ------------------------------------------------------------------ the roles ---

# Implemented rather than introspected. `.^find_method` on a role composes it into a
# class, which then demands the stub it declares, so asking a role about its own
# methods is how you make it complain about itself.
#
# `TokenCounter.count` takes a Str, and the string a policy measures is not the string
# a model receives: a message list has to be templated before it can be counted, and a
# counter taking a string cannot do that step. Hence a second role.
class CountingFake does PromptTokenizer {
    method count-prompt(@messages --> Int) { @messages.elems }
}

class AnsweringFake does Inference {
    method complete(@messages --> Hash) { %( kind => 'gap', wanted => 'x', missing => 'y' ) }
}

is CountingFake.new.count-prompt([1, 2, 3]), 3,
    'a prompt counter takes the message list rather than a string';
is AnsweringFake.new.complete([]).<kind>, 'gap',
    'and inference returns the raw answer, for intent-from to judge';
