use Test;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Actions;
use Ronosathwasha::Dialogue;
use Ronosathwasha::Intent;
use Ronosathwasha::Projection;

plan 7;

# The inventory boundary, from plan 039's stop 2: every intent the schema
# offers, driven through realization and reading, compared through the
# canonical projection. A new mismatch fails as unclassified, a repaired one
# fails as silently-better, a reclassified one fails as changed.
#
# **The map below is partly a declaration and partly a debt, and the split is
# the point.** Seven entries are the language as Kevin ruled it and will not be
# repaired; twelve are defects review 047 found and are waiting for one. Reading
# the map as either one thing loses the distinction that took a ruling to
# establish.
#
# So there is no single exit condition here. A declared entry leaving is a
# language change and has to be argued for as one; an owed entry leaving is a
# repair and is the point of measuring it.
#
# The six declared, all one mechanism: an inflection lands on a word the lexicon already
# lists, and the lexical parse wins exactly as designed, so a verbal intent reads
# back as a bare nominal identity. They arrived by two different routes, which is
# worth seeing because only one of them is a pattern:
#
#   - the tense suffix turned derivational, four entries in `[time]`. `roro`
#     ("very") plus past is `roroso` ("far past"), plus future is `rorotho`;
#     `rorotwatha` ("ancient") plus past is `rorotwathaso`; `she` ("this") plus
#     present is `sheme` ("today"). A productive-looking series, and the reason
#     the language has a time vocabulary at all.
#   - lexicalized greetings, two entries in `[phrase]`. `nara` ("good") plus
#     present is `narame` ("hello") and plus future is `narathe` ("goodbye").
#     One-offs rather than a series.
#
# Review 034 found five of these; the matrix found two more.
#
# **The seventh is not a lexicalization**, and Kevin took it off the ledger in
# the same ruling. `thwame` is listed in `[phrase]` as "I like", but that is just
# the regular present of `thwaswe` with the subject dropped, tangled up with
# `-swe`. The mismatch it produces is real and stays measured; what it is
# evidence about is a lexicon entry duplicating an ordinary inflection, not a
# collision the language decided on. It is here under protest rather than by
# declaration.
#
# The stem-plus-case collision was `ðo` under the subject particle spelling
# `ðoru`, which the lexicon listed as "reason", so the participant dissolved
# into a different word. Decision 7 derives that subject form by rule, so the
# pronoun could not move and the noun did: `nootha`, and `tonootha` for "why".
# See LANGUAGE.md decision 28.
#
# The question-word constraint was forty entries, five interrogatives times
# eight shapes, and every one of them said the same thing: an answer named a
# word that already spells a question and then described a sentence that was
# not one, or was a question about somewhere else. Plan 039 stop 4 routed it to
# `check-interrogative-consistency` in `intent-from`, where decoded fields and
# declarations are enough to see it. Those intents are now refused before they
# are realized, so they leave the matrix entirely rather than being classified
# by it: the forty did not become correct, they became unaskable.
#
# The twenty-four owed entries are the questioned classes, and their headings
# below say what they are. Short version: this matrix drove declaratives
# thoroughly and questions barely, so every construction the capabilities block
# promises the model about asking went unmeasured. Twelve of them were found by
# review 047, nine more by looking at the questioned predicate nobody had driven,
# and three by driving decision 29's selective marker, which arrived on main
# outside this file entirely.
#
# This file costs about two minutes on its own: 918 pipeline runs, each an intent
# decode, a realization, and a full sentence reading. The question dimensions are
# most of it, 324 runs from the two questioned classes and their kinds.
#
# That is now the slowest thing in `make check` by a wide margin, and the fix
# when it stops being tolerable is memoization rather than coverage:
# `predicate-roots`, `participant-stems` and `interrogative-bases` are rebuilt
# from the declarations on every single call, so roughly a thousand identical
# recomputations of three sets that cannot change during a run.

my IO::Path $data = repository-root.add('data');
my $script     = load-script($data.add('script.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));

my @roots = predicate-roots($lexicon, $morphology).keys.sort;
my @stems = participant-stems($lexicon, $morphology).keys.sort;
my @interrogatives = $lexicon.interrogative-words.keys.sort;

my %map;
my Int $cases = 0;

sub check(Str:D $key, %raw) {
    $cases++;

    my $sent = intent-from($lexicon, $morphology, %raw);
    return unless $sent.defined;   # a refused intent is outside the offered space

    my $said = realize-intent($script, $lexicon, $morphology, $sent);

    unless $said.defined {
        %map{$key} = 'unrealizable';
        return;
    }

    my $heard = read-sentence($script, $lexicon, $morphology, $said);

    unless $heard ~~ Understood {
        %map{$key} = "unreadable ($said)";
        return;
    }

    my $before = semantic-projection($lexicon, $morphology, $sent);
    my $after  = semantic-projection($lexicon, $morphology, $heard.reading);

    return if $before.matches($after);

    %map{$key} = "changes { $before.differences($after).join(',') } ($said)";
}

sub express(*%extra) {
    %(
        kind => 'express', predicate => 'thinə', speech_act => 'declarative',
        tense => 'present', aspect => 'simple', polarity => 'affirmative',
        modality => 'asserted', |%extra,
    )
}

# Class 1: every predicate root across each tense, simple declarative.
for @roots -> $root {
    for <past present future> -> $tense {
        check("predicate $root $tense", express(:predicate($root), :tense($tense)));
    }
}

# Class 2: every participant stem under each role, known-safe predicate.
for @stems -> $stem {
    for <subject object> -> $role {
        check("participant $stem $role",
            express(arguments => [ $%( 'role' => $role, stem => $stem ) ]));
    }
}

# Class 2b: the same stems again, this time as the questioned constituent.
#
# Review 047's finding, and the hole was mine: class 2 drove every participant
# in a declarative only, so an ordinary noun that becomes an interrogative word
# once the marker lands on it was never questioned by this matrix at all. That
# is precisely the shape plan 039 stop 4's admissibility boundary refused on its
# first run, `lari tomwuyu thinəme?`, and the matrix stayed green through it.
#
# It is not optional coverage. The capabilities block now tells the model that
# the question series is open, so naming a plain stem and scoping its
# constituent is a form the interface promises, and every promise the interface
# makes belongs in the declared surface this file measures.
#
# Class 3's questioned-subject case is now a special case of this one. Left
# where it is rather than folded in: it exists to state something about lexical
# interrogatives specifically, and the duplicated work is a second of runtime.
#
# Both question kinds, since decision 29 shipped `twe-`/`two-` and nothing here
# was driving it: every case this file built was open by omission, so the whole
# selective path arrived on main outside the matrix that says what the declared
# surface does. It measures clean today, which is exactly when the coverage is
# cheapest and least likely to be added.
for @stems -> $stem {
    for <subject object> -> $role {
        for <open selective> -> $asking {
            check("questioned $asking participant $stem $role",
                express(:speech_act<interrogative>, :question_scope($role),
                    :question_kind($asking),
                    arguments => [ $%( 'role' => $role, stem => $stem ) ]));
        }
    }
}

# Class 1b: every predicate root as the questioned predicate, both kinds.
#
# The hole left after 047 and class 2b, and neither of us saw it: both looked at
# questioned *participants*. Class 1 drives every root in three tenses as a
# declarative and stops there, so a questioned predicate was never built at all.
# Nine open failures were sitting in it, no new mechanism among them.
for @roots -> $root {
    for <open selective> -> $asking {
        check("questioned $asking predicate $root",
            express(:predicate($root), :speech_act<interrogative>,
                :question_scope<predicate>, :question_kind($asking)));
    }
}

# Class 3: every lexical interrogative in matching and conflicting scopes.
for @interrogatives -> $w {
    check("interrogative $w as declarative predicate", express(:predicate($w)));
    check("interrogative $w as questioned predicate",
        express(:predicate($w), :speech_act<interrogative>, :question_scope<predicate>));
    check("interrogative $w as declarative subject",
        express(arguments => [ $%( 'role' => 'subject', stem => $w ) ]));
    check("interrogative $w as questioned subject",
        express(:speech_act<interrogative>, :question_scope<subject>,
            arguments => [ $%( 'role' => 'subject', stem => $w ) ]));
    check("interrogative $w as subject of predicate question",
        express(:speech_act<interrogative>, :question_scope<predicate>,
            arguments => [ $%( 'role' => 'subject', stem => $w ) ]));
}

# ------------------------------------------- the declared boundary, and one more ---

# Ruled deliberate, 2026-08-01. A word here is not a defect and removing one is a
# language change: the inflection genuinely spells a word the lexicon lists, and
# the reader is right to find it.
my %lexicalized =
    # the tense suffix turned derivational, and the time vocabulary is the result
    'predicate roro past' => 'changes nominal,predicate,tense (roroso.)',
    'predicate roro future' => 'changes nominal,predicate,tense (rorotho.)',
    'predicate rorotwatha past' => 'changes nominal,predicate,tense (rorotwathaso.)',
    'predicate she present' => 'changes nominal,predicate,tense (sheme.)',

    # lexicalized greetings, one-offs rather than a series
    'predicate nara present' => 'changes nominal,predicate,tense (narame.)',
    'predicate nara future' => 'changes nominal,predicate,tense (narathe.)';

# Off the ledger in the same ruling, and here because the mismatch still fires.
# `thwame` is the regular present of `thwaswe` with the subject dropped, listed
# in `[phrase]` as though it were a fixed expression. Whether that entry should
# exist is a lexicon question nobody has answered; until somebody does, this
# measures it rather than blessing it.
my %listed-inflection =
    'predicate thwa present' => 'changes nominal,predicate,tense (thwame.)';

# Debt, and the only entries here that are. Defects awaiting repair rather than
# anything the language decided, kept so the repair has something to shrink,
# which is what this map was originally for.
#
# **One mechanism, across all twenty-four.** `to` plus any stem beginning with
# `ro` also divides as the listed word `toro`, and `parse-word`'s `Lexicalised`
# pass prefers a listed word reached with zero prefixes. That pass exists to stop
# `toro` decomposing into `to` plus `ro`, so this is the `totoro` guard producing
# wrong readings rather than a parser bug. `classify` already returns `Ambiguous`
# for every one of them; `Actions` then takes the frugal division deliberately,
# because refusing would reject `Lari thinəmedi`, which Kevin wrote. The
# resolution policy is the defect and nothing is hidden at the parse layer.
#
# The three lexicalized stems fail for the other reason already on the ledger:
# `nara`, `she` and `thwa` inflect onto listed words, so questioning them lands
# on `tenarame`, `tesheme` and `tethwame` whichever marker is used.
#
# The proposed repair, unbuilt: tie-break by fewest stems, then prefer the listed
# division. `Morphemes` already claims fewest stems "prefers inflection over
# compounding", and the listed-first pass violates it, taking `toro`+`ro` (two
# stems) over `roro` (one). That clears the `ro`-initial entries and leaves
# `tomwuyu` and `thinəmedi` untouched, both being one stem against one.
#
# The runtime boundary refuses all of them correctly. What is wrong is that the
# capabilities block promises the model this construction works, so the prose is
# ahead of the grammar until they are repaired.
my %questioned-participants =
    'questioned open participant rono subject' => 'changes participants (toronoru thinəme?)',
    'questioned open participant rono object' => 'changes participants (toronoyu thinəme?)',
    'questioned open participant roro subject' => 'changes participants (torororu thinəme?)',
    'questioned open participant roro object' => 'changes participants (tororoyu thinəme?)',
    'questioned open participant rorotwatha subject' => 'changes participants (tororotwatharu thinəme?)',
    'questioned open participant rorotwatha object' => 'changes participants (tororotwathayu thinəme?)',
    'questioned open participant roroso subject' => 'unreadable (tororosoru thinəme?)',
    'questioned open participant roroso object' => 'unreadable (tororosoyu thinəme?)',
    'questioned open participant rorotho subject' => 'unreadable (tororothoru thinəme?)',
    'questioned open participant rorotho object' => 'unreadable (tororothoyu thinəme?)',
    'questioned open participant rorotwathaso subject' => 'unreadable (tororotwathasoru thinəme?)',
    'questioned open participant rorotwathaso object' => 'unreadable (tororotwathasoyu thinəme?)';

# The class neither review looked at, both having watched the participants.
my %questioned-predicates =
    'questioned open predicate rono' => 'changes predicate (toronomo?)',
    'questioned open predicate roro' => 'changes predicate (tororomo?)',
    'questioned open predicate rorotwatha' => 'changes predicate (tororotwathamo?)',
    'questioned open predicate roroso' => 'changes predicate,tense (tororosomo?)',
    'questioned open predicate rorotho' => 'changes predicate,tense (tororothomo?)',
    'questioned open predicate rorotwathaso' => 'changes predicate,tense (tororotwathasomo?)',
    'questioned open predicate nara' => 'unreadable (tenarame?)',
    'questioned open predicate she' => 'unreadable (tesheme?)',
    'questioned open predicate thwa' => 'unreadable (tethwame?)',

    # The only entries the selective marker produces. All three are the
    # lexicalized stems, which collide on the stem rather than on the marker, so
    # `twe-` cannot help. Zero selective participant entries, which is the
    # measurement Codex's implementation earns.
    'questioned selective predicate nara' => 'unreadable (twenarame?)',
    'questioned selective predicate she' => 'unreadable (twesheme?)',
    'questioned selective predicate thwa' => 'unreadable (twethwame?)';

my %owed = |%questioned-participants, |%questioned-predicates;

my %expected = |%lexicalized, |%listed-inflection, |%owed;

is $cases,
    @roots.elems * 5 + @stems.elems * 6 + @interrogatives.elems * 5,
    'the matrix covers the declared surface, derived rather than counted by hand';

is-deeply (%map.keys.Set (-) %expected.keys.Set).keys.sort.List, (),
    'no unclassified mismatches: a new entry here is a new defect';

is-deeply (%expected.keys.Set (-) %map.keys.Set).keys.sort.List, (),
    'no silently repaired entries: an entry leaving is a language change';

is-deeply %map.keys.grep({ (%expected{$_}:exists) && %map{$_} ne %expected{$_} }).sort.List,
    (), 'no reclassifications: a changed mechanism is a changed defect';

is %map.elems, %expected.elems,
    'the boundary is exactly seven declared entries plus twenty-four owed';

# The ruling was for six, named one by one. A seventh arriving in that hash
# without a ruling behind it is the thing this pins: the split is the record of
# what Kevin decided, so it must not be somewhere a later edit can quietly widen.
is %lexicalized.elems, 6,
    'and six is what was ruled deliberate, not however many are in the hash';

# Not a count, which would only restate the hash. The finding is that the whole
# owed set is two mechanisms and no more: a stem beginning with `ro`, which
# collides with the listed `toro`, or one of the three that inflect onto a listed
# word. A twenty-fifth entry of any other shape is a different defect and must
# not slip in under these headings.
#
# `.words[3]` is the stem in both key shapes, since "questioned <kind>
# participant <stem> <role>" and "questioned <kind> predicate <stem>" agree up to
# that position. Deliberate when they were named.
my $known = %owed.keys.map({ .words[3] }).grep({
    not .starts-with('ro') and not $_ eq any(<nara she thwa>)
}).sort.List;

is-deeply $known, (),
    'every owed entry is the toro collision or a lexicalized stem, and nothing else';
