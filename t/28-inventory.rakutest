use Test;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Actions;
use Ronosathwasha::Dialogue;
use Ronosathwasha::Intent;
use Ronosathwasha::Projection;

plan 6;

# The inventory boundary, from plan 039's stop 2: every intent the schema
# offers, driven through realization and reading, compared through the
# canonical projection. A new mismatch fails as unclassified, a repaired one
# fails as silently-better, a reclassified one fails as changed.
#
# **The map below is a declaration, not a to-do list.** It was written as debt
# and Kevin ruled otherwise on 2026-08-01, shown all eight entries: six are
# deliberate lexicalizations, "entirely on purpose". The reader is therefore
# right about every one of them and the realizer is what must refuse, which is
# what `Dialogue`'s admissibility boundary now does.
#
# So this file's exit condition is not an empty map and never was. An entry
# leaving is a language change, and it has to be argued for as one.
#
# The six, all one mechanism: an inflection lands on a word the lexicon already
# lists, and the lexical parse wins exactly as designed, so a verbal intent reads
# back as a bare nominal identity. They arrived by two different routes, which is
# worth seeing because only one of them is a pattern:
#
#   - the tense suffix turned derivational, four entries in `[time]`. `roro`
#     ("very") plus past is `roroso` ("far past"), plus future is `rorotho`;
#     `rorotwatha` ("ancient") plus past is `rorotwathaso`; `she` ("this") plus
#     present is `sheme` ("today"). A productive-looking series, and the reason
#     the language has a time vocabulary at all.
#   - lexicalized greetings, two entries in `[phrase]`. `nara` ("good") plus
#     present is `narame` ("hello") and plus future is `narathe` ("goodbye").
#     One-offs rather than a series.
#
# Review 034 found five of these; the matrix found two more.
#
# **The seventh is not a lexicalization**, and Kevin took it off the ledger in
# the same ruling. `thwame` is listed in `[phrase]` as "I like", but that is just
# the regular present of `thwaswe` with the subject dropped, tangled up with
# `-swe`. The mismatch it produces is real and stays measured; what it is
# evidence about is a lexicon entry duplicating an ordinary inflection, not a
# collision the language decided on. It is here under protest rather than by
# declaration.
#
# The stem-plus-case collision was `ðo` under the subject particle spelling
# `ðoru`, which the lexicon listed as "reason", so the participant dissolved
# into a different word. Decision 7 derives that subject form by rule, so the
# pronoun could not move and the noun did: `nootha`, and `tonootha` for "why".
# See LANGUAGE.md decision 28.
#
# The question-word constraint was forty entries, five interrogatives times
# eight shapes, and every one of them said the same thing: an answer named a
# word that already spells a question and then described a sentence that was
# not one, or was a question about somewhere else. Plan 039 stop 4 routed it to
# `check-interrogative-consistency` in `intent-from`, where decoded fields and
# declarations are enough to see it. Those intents are now refused before they
# are realized, so they leave the matrix entirely rather than being classified
# by it: the forty did not become correct, they became unaskable.
#
# This file costs roughly a minute: 428 pipeline runs, each an intent decode,
# a realization, and a full sentence reading. If that grows painful, the
# vocabulary computations inside intent-from are the memoization candidates,
# not the coverage.

my IO::Path $data = repository-root.add('data');
my $script     = load-script($data.add('script.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));

my @roots = predicate-roots($lexicon, $morphology).keys.sort;
my @stems = participant-stems($lexicon, $morphology).keys.sort;
my @interrogatives = $lexicon.interrogative-words.keys.sort;

my %map;
my Int $cases = 0;

sub check(Str:D $key, %raw) {
    $cases++;

    my $sent = intent-from($lexicon, $morphology, %raw);
    return unless $sent.defined;   # a refused intent is outside the offered space

    my $said = realize-intent($script, $lexicon, $morphology, $sent);

    unless $said.defined {
        %map{$key} = 'unrealizable';
        return;
    }

    my $heard = read-sentence($script, $lexicon, $morphology, $said);

    unless $heard ~~ Understood {
        %map{$key} = "unreadable ($said)";
        return;
    }

    my $before = semantic-projection($lexicon, $morphology, $sent);
    my $after  = semantic-projection($lexicon, $morphology, $heard.reading);

    return if $before.matches($after);

    %map{$key} = "changes { $before.differences($after).join(',') } ($said)";
}

sub express(*%extra) {
    %(
        kind => 'express', predicate => 'thinə', speech_act => 'declarative',
        tense => 'present', aspect => 'simple', polarity => 'affirmative',
        modality => 'asserted', |%extra,
    )
}

# Class 1: every predicate root across each tense, simple declarative.
for @roots -> $root {
    for <past present future> -> $tense {
        check("predicate $root $tense", express(:predicate($root), :tense($tense)));
    }
}

# Class 2: every participant stem under each role, known-safe predicate.
for @stems -> $stem {
    for <subject object> -> $role {
        check("participant $stem $role",
            express(arguments => [ $%( 'role' => $role, stem => $stem ) ]));
    }
}

# Class 3: every lexical interrogative in matching and conflicting scopes.
for @interrogatives -> $w {
    check("interrogative $w as declarative predicate", express(:predicate($w)));
    check("interrogative $w as questioned predicate",
        express(:predicate($w), :speech_act<interrogative>, :question_scope<predicate>));
    check("interrogative $w as declarative subject",
        express(arguments => [ $%( 'role' => 'subject', stem => $w ) ]));
    check("interrogative $w as questioned subject",
        express(:speech_act<interrogative>, :question_scope<subject>,
            arguments => [ $%( 'role' => 'subject', stem => $w ) ]));
    check("interrogative $w as subject of predicate question",
        express(:speech_act<interrogative>, :question_scope<predicate>,
            arguments => [ $%( 'role' => 'subject', stem => $w ) ]));
}

# ------------------------------------------- the declared boundary, and one more ---

# Ruled deliberate, 2026-08-01. A word here is not a defect and removing one is a
# language change: the inflection genuinely spells a word the lexicon lists, and
# the reader is right to find it.
my %lexicalized =
    # the tense suffix turned derivational, and the time vocabulary is the result
    'predicate roro past' => 'changes nominal,predicate,tense (roroso.)',
    'predicate roro future' => 'changes nominal,predicate,tense (rorotho.)',
    'predicate rorotwatha past' => 'changes nominal,predicate,tense (rorotwathaso.)',
    'predicate she present' => 'changes nominal,predicate,tense (sheme.)',

    # lexicalized greetings, one-offs rather than a series
    'predicate nara present' => 'changes nominal,predicate,tense (narame.)',
    'predicate nara future' => 'changes nominal,predicate,tense (narathe.)';

# Off the ledger in the same ruling, and here because the mismatch still fires.
# `thwame` is the regular present of `thwaswe` with the subject dropped, listed
# in `[phrase]` as though it were a fixed expression. Whether that entry should
# exist is a lexicon question nobody has answered; until somebody does, this
# measures it rather than blessing it.
my %listed-inflection =
    'predicate thwa present' => 'changes nominal,predicate,tense (thwame.)';

my %expected = |%lexicalized, |%listed-inflection;

is $cases,
    @roots.elems * 3 + @stems.elems * 2 + @interrogatives.elems * 5,
    'the matrix covers the declared surface, derived rather than counted by hand';

is-deeply (%map.keys.Set (-) %expected.keys.Set).keys.sort.List, (),
    'no unclassified mismatches: a new entry here is a new defect';

is-deeply (%expected.keys.Set (-) %map.keys.Set).keys.sort.List, (),
    'no silently repaired entries: an entry leaving is a language change';

is-deeply %map.keys.grep({ (%expected{$_}:exists) && %map{$_} ne %expected{$_} }).sort.List,
    (), 'no reclassifications: a changed mechanism is a changed defect';

is %map.elems, %expected.elems,
    'the boundary is exactly what the language declares, six of it plus thwame';

# The ruling was for six, named one by one. A seventh arriving in that hash
# without a ruling behind it is the thing this pins: the split is the record of
# what Kevin decided, so it must not be somewhere a later edit can quietly widen.
is %lexicalized.elems, 6,
    'and six is what was ruled deliberate, not however many are in the hash';
