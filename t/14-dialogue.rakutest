use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Actions;
use Ronosathwasha::Intent;
use Ronosathwasha::TestModel;
use Ronosathwasha::ConversationState;
use Ronosathwasha::PromptContext;
use Ronosathwasha::TokenCounter;
use Ronosathwasha::Dialogue;

plan 52;

my IO::Path $data = repository-root.add('data');
my $script     = load-script($data.add('script.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));

sub answer(*%extra) {
    %(
        kind       => 'express',
        predicate  => 'thinə',
        speech_act => 'declarative',
        tense      => 'present',
        aspect     => 'simple',
        polarity   => 'affirmative',
        modality   => 'asserted',
        arguments  => [ $%( 'role' => 'subject', stem => 'la' ) ],
        |%extra,
    )
}

my $counter = PerWord.new;

#| Roomy on purpose. This file is about the loop; `t/18` is about the budget.
sub roomy { Budget.new(:total(10_000), :reserved(100)) }

sub turn($model, $context, Str $heard, $budget = roomy()) {
    take-turn($script, $lexicon, $morphology, $model, $context, $budget, $counter, $heard);
}

my $fresh = PromptContext.new(
    :schema(PromptInvariant.new(:label('response schema'), :text('kind express or gap'))),
    :capabilities(PromptInvariant.new(:label('language capabilities'), :text('three tenses'))),
    :state(ConversationState.new),
);

# ------------------------------------------------------------- one whole turn ---

my $model = scripted($lexicon, $morphology, answer());
my $one = turn($model, $fresh, 'Lari thinəme.');

isa-ok $one, Exchange, 'a turn produces an exchange';
ok $one.understood, 'the input was understood';
is $one.said, 'lari thinəme.', 'and the answer came back as Ronosathwasha';
is $one.state.depth, 2, 'both turns are recorded';
is $one.state.turns.head.speaker, Human, 'the person first';
is $one.state.turns.tail.speaker, Bot, 'then the bot';

# The whole architecture in one assertion: the model was handed meaning and
# returned meaning, and the text on both ends was made by the grammar.
isa-ok $one.state.turns.tail.meaning, Express,
    'what the bot said is stored as meaning, not as the string';

# ------------------------------------------------------ the model sees the prompt ---

is $model.seen.elems, 1, 'the model was asked once';
isa-ok $model.seen.head, PromptContext,
    'and handed a whole prompt, not a bare conversation';
is $model.seen.head.depth, 1,
    'including the turn just heard, which it has to answer';
ok $model.seen.head.render.contains('response schema'),
    'with the invariants it cannot answer without';
nok $model.seen.head.render.contains('lari thinəme.'),
    'and not the answer it has not given yet';

# The context handed back is the one to feed in next, and it has grown by the
# bot's turn rather than by a copy of the whole prompt.
isa-ok $one.context, PromptContext, 'the exchange carries the prompt forward';
is $one.context.state.depth, 2, 'with both turns in it';
is $one.context.schema.label, 'response schema', 'and the invariants intact';

# ---------------------------------------------------- a window too small refuses ---
#
# Not a conversational event. A prompt that cannot be assembled is a broken
# configuration, so it propagates the way an invented predicate does rather than
# arriving as a quiet half-prompt.

my $cramped = turn(
    scripted($lexicon, $morphology, answer()),
    $fresh,
    'Lari thinəme.',
    Budget.new(:total(4), :reserved(1)),
);

nok $cramped.defined, 'a window too small for the invariants fails the turn';
isa-ok $cramped.self.exception, X::Ronosathwasha::Window::Invariants,
    'as a configuration fault rather than a language one';

# ------------------------------------------------------ realization is canonical ---

my $back = scripted($lexicon, $morphology,
    answer(tense => 'past', arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                                           $%( 'role' => 'object',  stem => 'runə' ) ]));

is turn($back, $fresh, 'Lari thinəme.').said, 'lari runəyu thinəse.',
    'subject then object then verb, each particle agreeing with its own stem';

# `question_scope` is no longer optional on an interrogative. It stood implicit here,
# and the implicit value was always `predicate`, which is what `023` objected to: the
# only question a model could ask was the one the default happened to produce.
my $asking = scripted($lexicon, $morphology,
    answer(speech_act => 'interrogative', question_scope => 'predicate'));

is turn($asking, $fresh, 'Lari thinəme.').said, 'lari tethinəme?',
    'a question carries its prefix and its borrowed mark';

# ------------------------------------------------- the question lands by scope ---
#
# The other two questions, unreachable until the scope arrived: the marker goes to
# the questioned constituent, chosen by that word's own harmony class, and the verb
# stays unmarked. `Tororu thinəme?` reads this way; now it generates this way too.

sub ask(*%extra) {
    answer(speech_act => 'interrogative', |%extra)
}

is turn(scripted($lexicon, $morphology, ask(question_scope => 'subject')),
        $fresh, 'Lari thinəme.').said,
    'telari thinəme?', 'a subject question marks the subject and not the verb';

is turn(scripted($lexicon, $morphology, ask(
            question_scope => 'object',
            arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                           $%( 'role' => 'object',  stem => 'mwu' ) ],
        )), $fresh, 'Lari thinəme.').said,
    'lari tomwuyu thinəme?', 'an object question builds the corpus word tomwuyu';

# The precedence rule, on a constituent. `tomwu` is "what" with the question inside,
# so naming it under an object scope must not write a second marker: `to` plus `tomwu`
# would be `totomwuyu`, the same bug `toro`/`totoro` guards on the predicate side.
is turn(scripted($lexicon, $morphology, ask(
            question_scope => 'object',
            arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                           $%( 'role' => 'object',  stem => 'tomwu' ) ],
        )), $fresh, 'Lari thinəme.').said,
    'lari tomwuyu thinəme?', 'a stem that spells its question gains no second marker';

# ----------------------------------------------------- failures are carried, not fixed ---

my $unread = turn(scripted($lexicon, $morphology, answer()), $fresh, 'Lari thothinəme.');
nok $unread.understood, 'a retired form is not understood';
isa-ok $unread.understanding, NotUnderstood, 'and says so';
ok $unread.said.defined, 'while the bot still answers, since its turn is separate';

# The outcome plan 032 added: grammatical input the one-scope type cannot hold.
# An ordinary turn, not a fault, which is the entire reason it is a
# `SentenceOutcome` rather than an exception: `take-turn` needed no change for
# this test to pass.
my $loud = turn(scripted($lexicon, $morphology, answer()), $fresh, 'Tororu tethinəme?');
nok $loud.understood, 'a doubly marked question is not understood into a meaning';
isa-ok $loud.understanding, NotRepresentable, 'but is named as the type\'s limit';
ok $loud.said.defined, 'and the conversation carries on around it';

my $silent = turn(Silent.new, $fresh, 'Lari thinəme.');
nok $silent.said.defined, 'a gap produces no Ronosathwasha at all';
isa-ok $silent.intent, Gap, 'the gap is carried out to the caller';
is $silent.gap.missing, 'a decision nobody has made', 'with what was missing';

# ----------------------------------------------------------- a broken model propagates ---
#
# A model naming a word that does not exist is not a conversational event.

my $liar = scripted($lexicon, $morphology, answer(predicate => 'thinu'));
my $broken = turn($liar, $fresh, 'Lari thinəme.');

nok $broken.defined, 'an invented predicate fails the turn';
isa-ok $broken.self.exception, X::Ronosathwasha::Answer::Unknown,
    'as a model fault rather than a language one';

# Review 029's carrier finding, at the realization boundary: this answer used
# to reach the realizer and mark both subjects, `telari tenari thinəme?`, a
# sentence whose typed meaning said one scope. The refusal in `intent-from`
# is what keeps it from ever getting there.
my $crowded = scripted($lexicon, $morphology, ask(
    question_scope => 'subject',
    arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                   $%( 'role' => 'subject', stem => 'ro' ) ],
));
my $unpointed = turn($crowded, $fresh, 'Lari thinəme.');

nok $unpointed.defined, 'a question about one of two subjects fails the turn';
isa-ok $unpointed.self.exception, X::Ronosathwasha::Answer::Malformed,
    'before realization can mark both and claim it meant one';

# ---------------------------------------------------------- decision 22 ---
#
# The generation side. `realize-intent` builds a nominal predicate when the intent
# says so, and always writes the copularizer: rebuilding a sentence respects what
# somebody wrote, and generating one has nothing to respect, which is the same
# choice this sub already makes about word order.

sub identity(*%extra) {
    %( answer(), predicate => 'mirire', nominal_predicate => True, |%extra )
}

my %timeless = identity();
%timeless<tense>:delete;

is turn(scripted($lexicon, $morphology, %timeless), $fresh, 'Lari thinəme.').said,
    'lari mirireswe.', 'a timeless identity is realized without a tense morpheme';

is turn(scripted($lexicon, $morphology, identity(tense => 'present')), $fresh,
        'Lari thinəme.').said,
    'lari miriresweme.', 'and with one when the intent carries it';

is turn(scripted($lexicon, $morphology, identity(tense => 'past')), $fresh,
        'Lari thinəme.').said,
    'lari mirireswese.', 'past reaches the copularized nominal too';

# 023's finding on this sub: `Express` accepted polarity, modality and speech act on
# a nominal predicate, `intent-from` checked them, and `realize-intent` passed none
# of the three on. The realizer had the parameters since `7cf70bd`; they were dropped
# here, in the call. `mo` on the front `mirire` is the anti-harmonic negator leaning
# the wrong way on purpose.
my %denied = identity(polarity => 'negative');
%denied<tense>:delete;

is turn(scripted($lexicon, $morphology, %denied), $fresh, 'Lari thinəme.').said,
    'lari momirireswe.', 'a denied identity keeps its negation';

my %which = identity(speech_act => 'interrogative', question_scope => 'predicate');
%which<tense>:delete;

is turn(scripted($lexicon, $morphology, %which), $fresh, 'Lari thinəme.').said,
    'lari temirireswe?', 'and a questioned identity keeps its question';

# ------------------------------------------------- the admissibility boundary ---
#
# Plan 039 stop 4. `intent-from` admits these: every stem is declared and every
# combination is legal. What it cannot see is that the sentence, once written,
# reads back as something else, because seeing that needs the realizer, the
# reader and Projection, none of which it may import.

# `nara` is "good" and `nara` + present spells `narame`, which the lexicon lists
# as the phrase "hello". Kevin ruled the collision deliberate, so the reader is
# right and the realizer is what must refuse. One of t/28's seven.
my %hello = answer(predicate => 'nara', tense => 'present');
%hello<arguments> = [];

my $collided = turn(scripted($lexicon, $morphology, %hello), $fresh, 'Lari thinəme.');

nok $collided.said.defined, 'a meaning whose sentence means something else says nothing';
ok $collided.inadmissible.defined, 'and carries why instead';
is $collided.inadmissible.mechanism, MeaningChanged,
    'the dangerous mechanism: it wrote perfectly good Ronosathwasha';
is $collided.inadmissible.attempted, 'narame.',
    'naming the sentence it wrote, which is the evidence';
ok $collided.inadmissible.axes.elems > 0, 'and the axes that disagreed';

# The point of the whole type. A collision is not missing language: the meaning
# exists, the morphemes exist, and the spelling is taken by something else.
nok $collided.inadmissible ~~ ResponseIntent,
    'an inadmissible intent is not a response intent';
nok $collided.gap.defined, 'so it never reaches the gap channel';
is $collided.state.gaps.elems, 0, 'and the conversation records no gap';

# The choice was fine and stays recorded. Losing it would teach the next turn
# that the model decided nothing.
isa-ok $collided.intent, Express, 'the admitted intent is still the turn meaning';
ok $collided.summary.contains('inadmissible'), 'and the summary says what happened';

# A gap must not be dragged through the boundary: there is no sentence to check.
my $silent = turn(Silent.new, $fresh, 'Lari thinəme.');
nok $silent.inadmissible.defined, 'a gap is not an inadmissible intent';
ok $silent.gap.defined, 'and still arrives as the finding it is';
