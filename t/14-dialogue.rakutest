use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Actions;
use Ronosathwasha::Model;
use Ronosathwasha::TestModel;
use Ronosathwasha::ConversationState;
use Ronosathwasha::Dialogue;

plan 20;

my IO::Path $data = repository-root.add('data');
my $script     = load-script($data.add('script.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));

sub answer(*%extra) {
    %(
        kind       => 'express',
        predicate  => 'thinə',
        speech_act => 'declarative',
        tense      => 'present',
        aspect     => 'simple',
        polarity   => 'affirmative',
        modality   => 'asserted',
        arguments  => [ $%( 'role' => 'subject', stem => 'la' ) ],
        |%extra,
    )
}

sub turn($model, $state, Str $heard) {
    take-turn($script, $lexicon, $morphology, $model, $state, $heard);
}

my $fresh = ConversationState.new;

# ------------------------------------------------------------- one whole turn ---

my $model = scripted($lexicon, $morphology, answer());
my $one = turn($model, $fresh, 'Lari thinəme.');

isa-ok $one, Exchange, 'a turn produces an exchange';
ok $one.understood, 'the input was understood';
is $one.said, 'lari thinəme.', 'and the answer came back as Ronosathwasha';
is $one.state.depth, 2, 'both turns are recorded';
is $one.state.turns.head.speaker, Human, 'the person first';
is $one.state.turns.tail.speaker, Bot, 'then the bot';

# The whole architecture in one assertion: the model was handed meaning and
# returned meaning, and the text on both ends was made by the grammar.
isa-ok $one.state.turns.tail.meaning, Express,
    'what the bot said is stored as meaning, not as the string';

# ------------------------------------------------------- the model sees the state ---

is $model.seen.elems, 1, 'the model was asked once';
isa-ok $model.seen.head, ConversationState,
    'and handed the conversation, not a bare string';
is $model.seen.head.depth, 1,
    'including the turn just heard, which it has to answer';

# ------------------------------------------------------ realization is canonical ---

my $back = scripted($lexicon, $morphology,
    answer(tense => 'past', arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                                           $%( 'role' => 'object',  stem => 'runə' ) ]));

is turn($back, $fresh, 'Lari thinəme.').said, 'lari runəyu thinəse.',
    'subject then object then verb, each particle agreeing with its own stem';

my $asking = scripted($lexicon, $morphology, answer(speech_act => 'interrogative'));
is turn($asking, $fresh, 'Lari thinəme.').said, 'lari tethinəme?',
    'a question carries its prefix and its borrowed mark';

# ----------------------------------------------------- failures are carried, not fixed ---

my $unread = turn(scripted($lexicon, $morphology, answer()), $fresh, 'Lari thothinəme.');
nok $unread.understood, 'a retired form is not understood';
isa-ok $unread.understanding, NotUnderstood, 'and says so';
ok $unread.said.defined, 'while the bot still answers, since its turn is separate';

my $silent = turn(Silent.new, $fresh, 'Lari thinəme.');
nok $silent.said.defined, 'a gap produces no Ronosathwasha at all';
isa-ok $silent.intent, Gap, 'the gap is carried out to the caller';
is $silent.gap.missing, 'a decision nobody has made', 'with what was missing';

# ----------------------------------------------------------- a broken model propagates ---
#
# A model naming a word that does not exist is not a conversational event.

my $liar = scripted($lexicon, $morphology, answer(predicate => 'thinu'));
my $broken = turn($liar, $fresh, 'Lari thinəme.');

nok $broken.defined, 'an invented predicate fails the turn';
isa-ok $broken.self.exception, X::Ronosathwasha::Answer::Unknown,
    'as a model fault rather than a language one';
