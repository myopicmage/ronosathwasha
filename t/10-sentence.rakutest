use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Words;
use Ronosathwasha::Actions;
use Ronosathwasha::Sentence;
use Ronosathwasha::Realizer;

my IO::Path $data = repository-root.add('data');
my $script     = load-script($data.add('script.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));
my $corpus     = load-utterances($data.add('utterances.toml'));

plan $corpus.utterances.elems + 28;

sub read(Str $s)  { read-sentence($script, $lexicon, $morphology, $s) }
sub write(Reading $r) { realize-sentence($script, $lexicon, $morphology, $r) }

#| Only capitalisation is stripped, and the asymmetry is the point. Punctuation
#| is part of the written language: the script borrows English marks, they
#| appear in script runs on the page in a fallback font, and the realizer emits
#| them. Case cannot be part of it, because the script has none: 132 syllable
#| code points and no upper form among them, so a capital letter exists only in
#| the romanisation and nowhere in the text itself.
sub bare(Str $s) { $s.lc }

# --------------------------------------------------------------- the round trip ---
#
# Text to meaning to text, for every sentence in the corpus. Recognition and
# realization are separate implementations reading the same declarations, so a
# defect has to occur identically in both to survive this.

for $corpus.utterances -> $u {
    my $there = read($u.text);
    my $back  = $there ~~ Understood ?? write($there.reading) !! Str;

    is $back, bare($u.text), "{ $u.text } survives text to meaning to text";
}

for (
    'Lasa dələri Laariswe.',
    'Dələri Laariswe.',
    'Dələri Laari.',
    'Lasa dələri Laarisweme.',
    'Dələri runəswo.',
    'Dələri runəswomo.',
) -> $introduction {
    my $there = read($introduction);
    my $back  = $there ~~ Understood ?? write($there.reading) !! Str;

    is $back, bare($introduction),
        "$introduction survives text to meaning to text";
}

# ------------------------------------------------ each word chooses its own class ---

my $mine = read('Lasa runəru thinəme').reading;

is-deeply $mine.constituents.map({ realize-constituent($script, $morphology, $_) }).List,
    ('lasa', 'runəru'),
    'a neutral word and a back word stand next to each other, each with its own particle';

# The repaired case. `shamwu` is central then back, so the compound is back and
# takes `yu`. Reading the class off the head `sha` alone would give `yi`.
my $that = read('Shamwuyu twame').reading;

is realize-constituent($script, $morphology, $that.constituents.head), 'shamwuyu',
    'a compound takes its class from the whole compound, not from its head';

# ------------------------------------------------- a prefix on a constituent ---
#
# For the generated question: `te-/to-` on the word being asked about, which until
# now only the verb realizer could write. The alternant is the word's own choice,
# exactly as with every suffix; nothing else in the sentence has a say.

my $q = $morphology.by-id('question');

is realize-word($script, $morphology, ['mwu'], [$morphology.by-id('object')], :prefixes([$q])),
    'tomwuyu', 'a questioned back word takes the back alternant';

is realize-word($script, $morphology, ['la'], [$morphology.by-id('subject')], :prefixes([$q])),
    'telari', 'and a neutral word the front one, as its subject marker already does';

is realize-word($script, $morphology, ['la'], [$morphology.by-id('subject')]),
    'lari', 'while a word given no prefixes is what it always was';

# --------------------------------------------------------------- order is kept ---

is write(read('layi Mirireri mirimedi.').reading), 'layi mirireri mirimedi.',
    'the constituents come back in the order they were written';

is write(read('Mirireri layi mirimedi.').reading), 'mirireri layi mirimedi.',
    'and the other order comes back the other way';

# ------------------------------------------------------------------- refusals ---

# `miriroroyi` is `miri` (front) compounded with `roro` (back), carrying the
# object particle. It divides perfectly well: both stems are real, the particle
# is real, and the order is legal. It is the compound that has no harmony class,
# so there is no alternant to choose.
#
# Which is a live constraint on the language rather than a limit of this code:
# a front stem and a back stem cannot be compounded and then inflected. Nothing
# in LANGUAGE.md decides that, and every attested compound happens to agree.
my $crossed = parse-word($lexicon, $morphology, 'miriroroyi');

is-deeply $crossed.stems.List, ('miri', 'roro'), 'a cross-class compound divides fine';

my $broken = realize-constituent($script, $morphology, $crossed);

nok $broken.defined, 'and then has no class for its particle to agree with';
isa-ok $broken.self.exception, X::Ronosathwasha::Form::NoClass, 'which it says rather than guessing';

# ------------------------------------------------ a question survives both ways ---
#
# The corpus loop above covers only `Nari tethinəme?`, which is the one case that
# always worked: the marker is a prefix on the predicate, so reading it off the
# predicate and writing it back there agreed. Every other arrangement failed, and
# each of these failed differently.

sub round-trip(Str $s) {
    my $outcome = read($s);

    $outcome ~~ Understood ?? write($outcome.reading) !! Str;
}

# Was `nari toro.` before the scope existed, because nothing marked the clause and
# the reader saw no prefix. Then it stayed correct through stop 3 only because a
# nominal predicate was given no speech act at all, which this stop changes.
is round-trip('Nari toro?'), 'nari toro?',
    'a lexicalised interrogative keeps its question and gains no second marker';

is round-trip('Nari toroswo?'), 'nari toroswo?',
    'and the same with the copularizer written';

# Was `tororu tethinəme?` at the end of stop 3, with the marker on the subject and
# a second one manufactured on the verb.
is round-trip('Tororu thinəme?'), 'tororu thinəme?',
    'a questioned subject leaves the verb unmarked';
is round-trip('Tomwuyu thinəme?'), 'tomwuyu thinəme?',
    'and so does a questioned object';

is round-trip('Nari tethinəme?'), 'nari tethinəme?',
    'a questioned predicate still writes the marker it needs';

# Decision 26: a bare nominal alone is a subjectless zero-copula identity, so
# the greeting, the exclamative naming, the withdrawal and the lone question
# all survive text to meaning to text.
for 'Narame.', 'Runə.', 'Ya.', 'Toro?' -> $utterance {
    is round-trip($utterance), bare($utterance),
        "$utterance survives text to meaning to text";
}

# Revision 3, stop 1: the nominal parser learned the prefix series the
# realizer has written since `7cf70bd`, so the denied and the questioned
# identity finally round-trip instead of realizing cleanly and reading as
# nothing. These are the two sentences artifact 033 reported.
for 'Lari momirireswe.', 'Nari temirireswe?' -> $identity {
    is round-trip($identity), bare($identity),
        "$identity survives text to meaning to text";
}

# The nominal predicate reached by the productive route rather than the lexicalised
# one. Nothing spells the marker here, so it has to be written.
my $productive = Reading.new(
    :text('Nari temirireswe?'), :speech-act(Interrogative),
    :question-scope(QuestionsPredicate), :predicate('mirire'),
    :aspect(Simple), :polarity(Affirmative), :modality(Asserted),
    :nominal-predicate(True), :explicit-copula(True),
);

is realize-sentence($script, $lexicon, $morphology, $productive), 'temirireswe?',
    'a questioned identity built from a bare stem does write one';
