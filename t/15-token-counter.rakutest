use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::TokenCounter;

plan 14;

# ------------------------------------------------------------------ counting ---

my $words = PerWord.new;
ok $words ~~ TokenCounter, 'the fake satisfies the role a real tokenizer will';
is $words.count('lari thinəme .'), 3, 'and counts predictably, which is its whole job';
is $words.count(''), 0, 'including nothing at all';

my $guess = Approximate.new;
is $guess.count('abcd'), 1, 'the rule of thumb is four characters';
is $guess.count('abcde'), 2, 'rounding up, because a partial token is a token';

# The estimate is wrong in a direction worth pinning down. Ronosathwasha is
# private-use text, which no tokenizer has seen, so its code points fragment
# rather than combining. The rule of thumb charges the same for both.
is $guess.count('Lari thinəme.'), $guess.count('Xyzw abcdefgh.'),
    'and it cannot tell private-use script from English of the same length';

# ------------------------------------------------------------------- budgets ---

my $budget = Budget.new(:total(1000), :reserved(200));

is $budget.available, 800, 'a budget is the window minus what the answer needs';
ok $budget.fits(800), 'a prompt may use all of what is available';
nok $budget.fits(801), 'and not one token more';
is $budget.overflow(950), 150, 'overflow says how far over, so a caller trims by it';
is $budget.overflow(400), 0, 'and is zero when it fits';
is $budget.remaining(300), 500, 'remaining is what is left after a cost';

# ---------------------------------------------------- an impossible budget ---
#
# Caught where it is written rather than where it first fails to fit, because a
# budget that reserves everything is a configuration error and not a runtime
# condition anyone should be handling.

my $broken = try Budget.new(:total(100), :reserved(100));
nok $broken.defined, 'reserving the whole window is refused';
isa-ok $!, X::Ronosathwasha::Budget::Impossible, 'when the budget is built';
