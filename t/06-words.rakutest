use Test;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Words;

plan 37;

my IO::Path $data = repository-root.add('data');
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));
my $corpus     = load-utterances($data.add('utterances.toml'));

sub split(Str $w) { parse-word($lexicon, $morphology, $w) }

# ------------------------------------------------------------ the simple cases ---

my $eats = split('thinəme');
is-deeply $eats.stems.List, ('thinə',), 'the stem is found';
is-deeply $eats.suffixes.map(*.id).List, ('present',), 'and the tense after it';
is-deeply $eats.prefixes.List, (), 'with nothing before it';

my $eating = split('thinəmedi');
is-deeply $eating.suffixes.map(*.id).List, ('present', 'continuous'),
    'two suffixes in the order they are written';

# --------------------------------------- position resolves the shared spellings ---
#
# This is what `data/morphology.toml` was restructured for. The letters are
# identical and only the side of the stem differs.

my $not-eat = split('mothinəme');
is-deeply $not-eat.prefixes.map(*.id).List, ('negation',),
    'mo before the stem is the negator';
is-deeply $not-eat.suffixes.map(*.id).List, ('present',),
    'while me after it is the tense';

my $loves = split('rorothwamo');
is-deeply $loves.suffixes.map(*.id).List, ('present',),
    'and mo after a back stem is the tense, not the negator';
is-deeply $loves.prefixes.List, (),
    'with no prefix at all';

# ------------------------------------------------------------- the full stack ---
#
# Decision 16's own example: modality, negation, speech act, predicate, tense.

my $maybe-dont-love = split('lumedororothwamo');
is-deeply $maybe-dont-love.prefixes.map(*.id).List,
    ('potential', 'negation', 'command'),
    'three prefixes in the order decision 16 fixed';
is-deeply $maybe-dont-love.stems.List, ('rorothwa',),
    'on a stem the lexicon lists only with its infinitive';
is-deeply $maybe-dont-love.suffixes.map(*.id).List, ('present',),
    'and the tense still lands after the stem';

# ------------------------------------------------------ backtracking is needed ---
#
# `medi` is a stem and `me` is a legal prefix. A ratcheting token takes the
# prefix, leaves `dime`, and fails. This passes only because TOP is a regex.

my $goes = split('medime');
is-deeply $goes.stems.List, ('medi',), 'a stem beginning with a prefix spelling is still the stem';
is-deeply $goes.prefixes.List, (), 'and no prefix was taken from it';

# ----------------------------------------------------------------- compounds ---

my $that-thing = split('shamwuyi');
is-deeply $that-thing.stems.List, ('sha', 'mwu'), 'a compound is two stems';
is-deeply $that-thing.suffixes.map(*.id).List, ('object',), 'with one particle after both';

# ------------------------------------------------------- against the corpus ---
#
# Every word of every current utterance must divide. This is the assertion that
# makes the grammar answerable to the language rather than to its own tests.

my @failed = $corpus.utterances.map({
    .text.words.grep({ not split(.subst(/<[?.,!]>/, '', :g)).defined }).Slip
});

is-deeply @failed.sort.unique.List, (),
    'every word in the corpus divides into declared morphemes';

my $nonsense = split('thinəzzz');
nok $nonsense.defined, 'a string that is not built from declared morphemes fails';

# --------------------------------------- a defined word beats its derivation ---
#
# Kevin's ruling: `toro` is `to` plus `ro` and it is also simply the word for
# "who", both are true, and the second is how people say it. So the default parse
# tries the listed words first and falls back to the productive division.

is-deeply split('toro').stems.List, ('toro',),
    'a word the lexicon defines is not divided into the morphemes that derive it';
is split('toro').prefixes.elems, 0, 'so no question marker is taken off it';

is-deeply split('tethinəme').stems.List, ('thinə',),
    'a word the lexicon does not define is still divided';
is split('tethinəme').prefixes.head.id, 'question',
    'and the question marker is found where it is the only reading';

# The two words this was quietly destroying. Both are listed entries, and both
# divided into affixes that all exist: `meliya` came apart as negation plus
# potential plus `ya`, roughly "not might it". Nothing objected because every
# piece was declared.
#
# `medi`, `tono`, `methe`, `molu` and `luru` survived the old rule, but only
# because their wrong division failed and the grammar backtracked. These two
# died because theirs happened to succeed.
is-deeply split('meliya').stems.List, ('meliya',), 'meliya is understand, not "not might it"';
is-deeply split('moluyo').stems.List, ('moluyo',), 'and moluyo is a crab';

# Nothing that already worked moved.
is-deeply split('demirime').stems.List, ('miri',), 'a productive word is unchanged';
is-deeply split('shamwu').stems.List, ('sha', 'mwu'), 'and so is a compound';

# ------------------------------------------------------ the one ambiguous form ---
#
# `swe` and `swo` are the only forms in the language with two claimants at one
# position: the infinitive and the copularizer share both. Position, which
# settles everything else here, has nothing to say about them.

my @claimants = $morphology.current
    .grep(*.position == Suffix)
    .grep({ .forms.first('swe').defined })
    .map(*.id)
    .sort;

is-deeply @claimants.List, ('copularizer', 'infinitive'),
    'two current suffixes claim swe, which is why anything below is needed';

my $host = stem-hosts($lexicon, $morphology);

is-deeply $host<mirire>.keys.List, (NominalStem,),
    'a stem listed only under [noun] is nominal';
is-deeply $host<miri>.keys.List, (VerbStem,),
    'and one recovered from a [verb] infinitive is verbal';

# The case the lexicon genuinely has both ways. Not a defect: `thinəswe` is
# `thinə` plus the infinitive, so the noun and the verb stem are the same string
# by derivation rather than by accident.
is-deeply $host<thinə>.keys.map(*.key).sort.List, ('NominalStem', 'VerbStem'),
    'a stem that is both a noun and a verb stem says so';

# The defect this resolves. `mirireswe` is "I am a teacher", and it used to come
# back with a nonfinite marker on a noun because the infinitive is declared
# first and `.first` took it.
is split('mirireswe').suffixes.head.id, 'copularizer',
    'swe on a nominal stem is the copularizer';
is split('mirireswe').suffixes.head.gloss, 'COP',
    'and glosses as one';

# Nothing else moved. A word with no ambiguous form must divide exactly as
# before, which is what the corpus assertion above is really guarding.
is split('mothinəme').prefixes.head.id, 'negation',
    'an unambiguous prefix is untouched by any of this';
is split('mirireri').suffixes.head.id, 'subject',
    'and so is an unambiguous suffix';

# ------------------------------- the nominal parser learns the prefix series ---
#
# Revision 3, stop 1. The realizer has written modality, polarity and speech
# act on nominal predicates since `7cf70bd`; this parser knew only the suffix
# side, so `momirireswe` swallowed `mo` into the stem, went MixedWord, and the
# denied identity realized cleanly and read back as nothing.

use Ronosathwasha::Script;
my $script = load-script(repository-root.add('data').add('script.toml'));

sub nominal(Str $w) { parse-nominal-predicate($script, $morphology, $w) }

sub shape($parse) { ($parse.prefixes».id.List, $parse.stems.List, $parse.suffixes».id.List) }

is-deeply nominal('momirireswe').&shape,
    (('negation',), ('mirire',), ('copularizer',)),
    'the denied identity divides, negator and copula around the stem';

is-deeply nominal('temirireswe').&shape,
    (('question',), ('mirire',), ('copularizer',)),
    'and so does the questioned one';

# The anti-harmonic negator is verified from the declarations, so a negator
# leaning the *right* way is refused as a negator, and the word falls through
# to what it can only be: a name that happens to start with `me`. Harmony
# decides which reading survives, not a table in this file.
is-deeply nominal('memirireswe').&shape,
    ((), ('memirire',), ('copularizer',)),
    'a right-leaning negator is no negator, just the start of a name';

# Decision 16 fixes the order: modality, negation, speech act. The reversed
# order must not divide, or the fixed order stops being recoverable structure.
nok nominal('temomirireswe').defined,
    'speech act before negation is not a word';
