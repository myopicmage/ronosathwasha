use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Intent;

plan 63;

my IO::Path $data = repository-root.add('data');
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));

sub intent(%raw) { intent-from($lexicon, $morphology, %raw) }

my %eat =
    kind       => 'express',
    predicate  => 'thinə',
    speech_act => 'declarative',
    tense      => 'present',
    aspect     => 'simple',
    polarity   => 'affirmative',
    modality   => 'asserted',
    arguments  => [ $%( 'role' => 'subject', stem => 'la' ) ];

# ----------------------------------------------------------------- accepted ---

my $ok = intent(%eat);
isa-ok $ok, Express, 'a well-formed intent is accepted';
is $ok.predicate, 'thinə', 'the predicate survives';
is $ok.tense, Present, 'and the features are typed rather than strings';
is $ok.participants.head.role, Subject, 'as are the argument roles';
is $ok.participants.head.stem, 'la', 'with their stems';

# ------------------------------------------------- the model cannot invent ---
#
# The whole point. A schema-constrained decoder can guarantee the shape of the
# JSON and cannot guarantee that a word exists, so the check is here.

my $invented = intent(%( %eat, predicate => 'thinu' ));
nok $invented.defined, 'a predicate the lexicon does not list is refused';
isa-ok $invented.self.exception, X::Ronosathwasha::Answer::Unknown, 'as an unknown value';
is $invented.self.exception.value, 'thinu',
    'and the refusal carries what the model actually sent';

my $badarg = intent(%( %eat, arguments => [ $%( 'role' => 'subject', stem => 'zzz' ) ] ));
nok $badarg.defined, 'an argument stem it does not list is refused too';

my $badrole = intent(%( %eat, arguments => [ $%( 'role' => 'indirect', stem => 'la' ) ] ));
nok $badrole.defined, 'and a role the language does not mark';

my $badtense = intent(%( %eat, tense => 'pluperfect' ));
nok $badtense.defined, 'a tense the language does not have is refused';
is $badtense.self.exception.field, 'tense', 'naming the field it came from';

# A verb stem the lexicon lists only with its infinitive is nameable, because
# the grammar can divide a word built on it. `rorothwaswo` is listed;
# `rorothwa` is what gets inflected.
ok intent(%( %eat, predicate => 'rorothwa' )).defined,
    'a stem recovered from an infinitive is nameable';

nok intent(%( %eat, predicate => 'me' )).defined,
    'while an affix is not a predicate, however real it is';

# Review 027's split, by semantic position. The finished infinitive is not a
# root: inflecting `miriswe` builds `miriswese`, which reads back as the
# nominal `miri` with a copula and a tense, a silent meaning change. The same
# form is a legal participant, since `Thinəswe twame` is corpus, and the bare
# root is not, since it is the piece of a word rather than a word.
nok intent(%( %eat, predicate => 'miriswe' )).defined,
    'a bound infinitive form is refused as a predicate';

ok intent(%( %eat, arguments => [ $%( 'role' => 'object', stem => 'thinəswe' ) ] )).defined,
    'while an infinitive may stand as a participant';

nok intent(%( %eat, arguments => [ $%( 'role' => 'object', stem => 'miri' ) ] )).defined,
    'and a bare root may not';

# ---------------------------------------------------------------------- gaps ---
#
# Not an error path. This is the output the project exists to collect.

my $gap = intent(%(
    kind    => 'gap',
    wanted  => 'I usually eat',
    missing => 'habitual aspect',
));

isa-ok $gap, Gap, 'a gap is an ordinary intent';
is $gap.missing, 'habitual aspect', 'carrying what the language lacks';

nok intent(%( kind => 'gap', wanted => 'something' )).defined,
    'but a gap must say what is missing';

# An empty string is the shape a model reaches for when it has nothing to say and
# the schema demands a field anyway, so it is the case most likely to arrive. The
# guard against it was inert: `~%raw{$field}.chars` stringifies the count, and `"0"`
# is true, so it admitted everything it was written to refuse.
nok intent(%( kind => 'gap', wanted => '', missing => 'habitual aspect' )).defined,
    'an empty wanted is refused, not merely a missing one';

nok intent(%( kind => 'gap', wanted => 'I usually eat', missing => '' )).defined,
    'and an empty missing, which is a gap that reports nothing';

# ------------------------------------------------------------------ malformed ---

nok intent(%( kind => 'chat', predicate => 'thinə' )).defined,
    'a kind outside the two is refused rather than guessed at';

# ------------------------------------------------- the shape is checked twice ---
#
# Plan 014's requirement, promised in ModelProtocol's pod since the beginning
# and found by review 027 happening only in the sampling grammar. These are
# 027's probes, each of which was previously accepted: coercion flattened
# JSON's three silences and two mistypings into plausible values.

nok intent(%( %eat, extra => 'field' )).defined,
    'an express carrying a key it has no field for is refused';

nok intent(%( %eat,
    arguments => [ $%( 'role' => 'subject', stem => 'la', mood => 'x' ) ],
)).defined, 'and so is an argument carrying one';

my $stringy = intent(%( %eat, nominal_predicate => 'false' ));
nok $stringy.defined, 'a string pretending to be a boolean is refused';
isa-ok $stringy.self.exception, X::Ronosathwasha::Answer::Malformed,
    'rather than truthified into a nominal, which is what it became before';

my $numeric = intent(%( kind => 'gap', wanted => 42, missing => 'habitual aspect' ));
nok $numeric.defined, 'a gap whose wanted is a number is refused';
ok $numeric.self.exception.message.contains('not a string'),
    'instead of stringified into well-typed evidence, the worst of the five';

nok intent(%( kind => 'gap', wanted => 'x', missing => 'y', predicate => 'thinə' )).defined,
    'a gap carrying an express field is answering two questions at once';

# Null and absent are different silences: a missing tense is the timeless
# identity, an explicit null is a refusal to answer.
my $null = intent(%( %eat, nominal_predicate => True, tense => Any ));
nok $null.defined, 'an explicit null tense is refused';
ok $null.self.exception.message.contains('omit the field'),
    'and told apart from the absence that means something';

# There is no field anywhere in an intent that could hold Ronosathwasha, which
# is the architectural commitment stated as a type rather than as a promise.
is-deeply Express.^attributes.map(*.name).grep(*.contains('text')).List, (),
    'no intent carries text for the realizer to trust';

# ---------------------------------------------------------- decision 22 ---
#
# `Express` was the last of the three meaning types to learn about nominal
# predication. `Reading` had it from the start and `Utterance` gained it with the
# corpus, and until it landed here a model could not choose to say what something
# *is*: every intent it produced was a verb, because there was no field for
# anything else.

my %teacher = %eat, predicate => 'mirire', nominal_predicate => True;

my $anchored = intent(%teacher);
isa-ok $anchored, Express, 'a model may say what something is';
ok $anchored.nominal-predicate, 'and the intent records that it is an identity';
is $anchored.tense, Present, 'with a tense when one was sent';

# The timeless identity, which is the reading decision 22 exists for. No `tense`
# key at all rather than a null, because absence is the meaning.
my %timeless = %teacher;
%timeless<tense>:delete;

my $identity = intent(%timeless);
isa-ok $identity, Express, 'and may leave it out entirely';
nok $identity.tense.defined, 'which is a timeless identity rather than a default present';
ok $identity.summary.contains('untensed'),
    'reported as untensed rather than as a tense it does not have';
ok $identity.summary.contains('is-a'), 'and distinguished from a verbal intent';

# A verb with no tense is not a well-formed word, so the pair is refused rather
# than repaired. A schema-constrained decoder can guarantee both fields are the
# right shape and cannot guarantee the combination means anything.
my %untensed-verb = %eat;
%untensed-verb<tense>:delete;

my $refused = intent(%untensed-verb);
nok $refused.defined, 'a verbal predicate with no tense is refused';
isa-ok $refused.self.exception, X::Ronosathwasha::Answer::Malformed,
    'as a malformed answer rather than a default supplied quietly';
ok $refused.self.exception.message.contains('only an identity may be timeless'),
    'saying which combination was wrong';

my $continuous-identity = intent(%( %timeless, aspect => 'continuous' ));
nok $continuous-identity.defined,
    'an untensed continuous identity is refused';
isa-ok $continuous-identity.self.exception,
    X::Ronosathwasha::Answer::Malformed,
    'at the model-answer boundary rather than after realization';
ok $continuous-identity.self.exception.message.contains('requires a tense marker'),
    'and names the canonical rule the fields violated';

# --------------------------------------------------------- the question scope ---
#
# Review `023`: an interrogative has to say what it questions. Until now a model
# could only ask `Nari tethinəme?`, because a speech act with nowhere to land put
# the marker on the predicate by default and every other question was unreachable.

my %asks = %eat, speech_act => 'interrogative', question_scope => 'subject';

my $question = intent(%asks);
isa-ok $question, Express, 'a model may ask about a constituent';
is $question.question-scope, QuestionsSubject, 'and the scope is typed rather than a string';
ok $question.summary.contains('questions subject'),
    'with the summary carrying it, since two questions that differ must read differently';

is intent(%( %asks, question_scope => 'predicate' )).question-scope, QuestionsPredicate,
    'the predicate is one scope among five rather than the only one';

# The wire offers three of the five scopes, and the two absences have a reason. A
# `Reading` can question a locative or an unmarked word because the parsed sentence
# contains the word the marker sat on; an `Express` cannot, so offering either would
# invite a choice that ends in refusal every time. A model that needs them reports
# the interface gap instead, which is the channel built for exactly this.
nok intent(%( %asks, question_scope => 'locative' )).defined,
    'a locative question is not offered, since an intent cannot carry one';
nok intent(%( %asks, question_scope => 'constituent' )).defined,
    'nor an unmarked constituent, for the same reason';

my $invented-scope = intent(%( %asks, question_scope => 'polar' ));
nok $invented-scope.defined, 'a scope outside the three is refused';
is $invented-scope.self.exception.field, 'question_scope', 'naming the field it came from';

# A scope naming a constituent is a promise the marker has somewhere to land, and
# `%eat` names only a subject. Same shape as the verb with no tense: two individually
# legal fields whose combination means nothing.
my $unmarked = intent(%( %eat, speech_act => 'interrogative', question_scope => 'object' ));
nok $unmarked.defined, 'a question about an object the answer never names is refused';
isa-ok $unmarked.self.exception, X::Ronosathwasha::Answer::Malformed,
    'as a combination that means nothing rather than an unknown value';

is intent(%( %asks,
    question_scope => 'object',
    arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                   $%( 'role' => 'object',  stem => 'runə' ) ],
)).question-scope, QuestionsObject, 'while a question about an object it names is accepted';

# Review 029's other half of the carrier rule: exactly one, not at least one.
# The schema permits repeated roles, so "question the subject" with two
# subjects marked both, `telari tenari thinəme?`, while the type recorded one
# scoped constituent and nothing said which.
my $crowd = intent(%( %asks,
    arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                   $%( 'role' => 'subject', stem => 'ro' ) ],
));
nok $crowd.defined, 'a question about the subject with two subjects is refused';
ok $crowd.self.exception.message.contains('a scope that names one'),
    'since the type cannot say which one is asked about';

# This does not decide what a repeated participant means, which is undecided
# language; the refusal is only about a scope that cannot point.
ok intent(%( %eat,
    arguments => [ $%( 'role' => 'subject', stem => 'la' ),
                   $%( 'role' => 'subject', stem => 'ro' ) ],
)).defined, 'a declarative may still repeat a role, undecided rather than refused';

# ------------------------------------------------- the pair cannot disagree ---
#
# Enforced in `Semantics::Asks`, which all three meaning types compose, so this is
# the same rule `Utterance` and `Reading` obey rather than a fourth copy of it.

my $unscoped = intent(%( %eat, speech_act => 'interrogative' ));
nok $unscoped.defined, 'an interrogative with no scope is refused';
isa-ok $unscoped.self.exception, X::Ronosathwasha::Meaning::ScopeDisagrees,
    'as a meaning that disagrees with itself, not a malformed answer';

my $scoped-statement = intent(%( %eat, question_scope => 'subject' ));
nok $scoped-statement.defined, 'and so is a declarative that claims to question something';
