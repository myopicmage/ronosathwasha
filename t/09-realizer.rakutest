use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Realizer;

my IO::Path $data = repository-root.add('data');
my $script     = load-script($data.add('script.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));
my $corpus     = load-utterances($data.add('utterances.toml'));

plan $corpus.utterances.elems + 18;

sub verb(Str $stem, *%f) { realize-verb($script, $morphology, $stem, |%f) }

# --------------------------------------- every corpus predicate regenerates ---
#
# For each sentence, build the predicate from the meaning Kevin declared and assert
# the result is a word he actually wrote. Recognition already checks the other
# direction, so together these close the round trip on the morphology.
#
# Which predicate to build depends on `nominal-predicate`. Before that field
# existed this loop built a verb for every entry, and the first copular sentence
# offered to the corpus failed here rather than at the schema: it built `mirimedi`
# for `Lari miriswemedi.`, because the declared meaning said present continuous and
# nothing said a copularizer was in there.

for $corpus.utterances -> $u {
    my $built = $u.nominal-predicate
        ?? realize-nominal-predicate(
               $script, $morphology, $u.predicate,
               :copularized($u.explicit-copula),
               :tense($u.tense),
               :aspect($u.aspect),
           )
        !! verb(
               $u.predicate,
               :speech-act($u.speech-act),
               :tense($u.tense),
               :aspect($u.aspect),
               :polarity($u.polarity),
               :modality($u.modality),
           );

    my Str $kind = $u.nominal-predicate ?? 'nominal predicate' !! 'verb';

    ok $built.defined && $u.text.lc.words.first({ .subst(/<[?.,!]>+$/, '') eq $built }).defined,
        "{ $u.text } contains the $kind built from its meaning ({ $built // 'failed' })";
}

# ----------------------------------------------------------- harmony is chosen ---

is verb('thinə'), 'thinəme', 'a front stem takes the front present';
is verb('rorothwa'), 'rorothwamo', 'a back stem takes the back present';
is verb('twa'), 'twame', 'a neutral stem takes the front alternant';

is verb('thinə', :tense(Past)), 'thinəse', 'front past';
is verb('rorothwa', :tense(Past)), 'rorothwaso', 'back past';
is verb('rorothwa', :tense(Future)), 'rorothwatho', 'back future, both halves of the pair now shipped';

# ------------------------------------------------- anti-harmony, with no branch ---
#
# The negator disagrees with its host on purpose, and nothing in the realizer
# knows that. The declaration crossed the alternants and `form-for` does the
# rest, so these two lines run the same code as the tense marker above.

is verb('thinə', :polarity(Negative)), 'mothinəme',
    'a front stem takes the back-looking negator';
is verb('rorothwa', :polarity(Negative)), 'merorothwamo',
    'and a back stem takes the front-looking one';

# ----------------------------------------------------------- the whole stack ---
#
# Decision 16 writes this word out by hand. Nothing seeded it here.

is verb('rorothwa', :modality(Potential), :polarity(Negative), :speech-act(Imperative)),
    'lumedororothwamo',
    'modality, negation, speech act, predicate, tense, in decision 16 order';

# ------------------------------------------------------------------ paradigm ---

my %front = paradigm($script, $morphology, 'thinə').Hash;
is %front<command>, 'dethinəme', 'the command cell';
is %front<question>, 'tethinəme', 'the question cell, which the page also writes';

my %back = paradigm($script, $morphology, 'rorothwa').Hash;
is %back<command>, 'dororothwamo', 'and decision 16 writes this one too';

# ---------------------------------------------------------------- refusals ---

my $mixed = verb('thino');
nok $mixed.defined, 'a disharmonic stem cannot be inflected';
isa-ok $mixed.self.exception, X::Ronosathwasha::Form::NoClass, 'and says why rather than guessing an alternant';

# ---------------------------------------------------------- decision 22 ---

is realize-nominal-predicate($script, $morphology, 'laari'),
    'laariswe', 'a front name takes the front copularizer';
is realize-nominal-predicate($script, $morphology, 'laari', :tense(Present)),
    'laarisweme', 'explicit present follows the copularizer';
is realize-nominal-predicate($script, $morphology, 'laari', :copularized(False)),
    'laari', 'ordinary identity may use a zero copula';
is realize-nominal-predicate(
    $script, $morphology, 'laari',
    :tense(Present), :aspect(Continuous),
), 'laariswemedi', 'aspect follows an explicitly tensed copular predicate';
