use Test;

use X::Ronosathwasha;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Words;
use Ronosathwasha::Gloss;

plan 57;

my IO::Path $data = repository-root.add('data');

my $script     = load-script($data.add('script.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));

# ------------------------------------------------------- the declared labels ---

is $morphology.morphemes.grep({ not .gloss.chars }).elems, 0,
    'every morpheme declares a gloss label';

# Two current morphemes sharing a label would make a gloss line ambiguous about
# which morpheme was written. Superseded ones deliberately share with their
# replacements, so only the current set is checked.
is $morphology.current.map(*.gloss).repeated.elems, 0,
    'and no two current morphemes share one';

is $morphology.by-id('past').gloss, 'PST', 'the past is Leipzig PST';
is $morphology.by-id('past-je').gloss, 'PST',
    'and the morpheme it superseded keeps the label of the job it did';
is $morphology.by-id('selective-question').gloss, 'Q.SEL',
    'the selective interrogative names both the question and its restriction';

# ----------------------------------------------------- the label is required ---
#
# The loader's job rather than a test's, and this asserts that the loader does
# it. A morpheme added without a gloss must not reach the program at all: the
# alternative is a hole appearing in a gloss line much later, at which point
# nothing points back at the declaration that caused it.

my $ungloss = $*TMPDIR.add("rono-gloss-{ $*PID }.toml");

$ungloss.spurt(q:to/TOML/);
    [[morpheme]]
    id = "invented"
    role = "tense"
    attaches_to = ["verb"]
    position = "suffix"
    alternation = "harmonic"
    front_stem = "ke"
    back_stem = "ko"
    status = "current"
    TOML

my $refused = load-morphology($ungloss);

nok $refused.defined, 'a morpheme with no gloss does not load';
isa-ok $refused.self.exception, X::Ronosathwasha::Declaration::BadValue,
    'and says which declaration was bad';

$ungloss.unlink;

# ------------------------------------------------- prose becomes one label ---

is short-gloss('to teach'), 'teach', 'an infinitive gloss loses its "to"';
is short-gloss('who (question-person)'), 'who', 'a parenthetical comes off';
is short-gloss('language, tongue'), 'language', 'the first sense is taken';
is short-gloss('that over there'), 'that.over.there',
    'and a multi-word gloss joins with periods, which is Leipzig rule 4';

# The order the reduction runs in, asserted rather than described. A comma
# inside the parenthetical must not be read as a sense boundary.
is short-gloss('and, and then, furthermore (clause-level discourse continuation)'),
    'and', 'the parenthetical is removed before the sense is chosen';

# --------------------------------------------------------------- stem labels ---

my $tables = stem-tables($lexicon, $morphology);
my $stems  = $tables.glosses;

is $stems<mirire>.nominal, 'teacher', 'a listed noun glosses from its own entry';
is $stems<miri>.verbal, 'teach',
    'and a verb stem recovered from its infinitive takes the infinitive gloss';

nok $stems<swe>.defined, 'the bound morphology is not offered as a stem';
nok $stems<laari>.defined, 'and neither is a name nobody declared';

# ------------------------------------------------------------ two senses ---
#
# `thinə` is "food" under `[noun]` and "eat" under `[verb]`, because `thinəswe`
# derives the predicate from the noun. One string, two labels, and the affixes
# say which is meant.

is $stems<thinə>.nominal, 'food', 'a stem in both sections keeps its noun gloss';
is $stems<thinə>.verbal, 'eat', 'and its verb gloss';

is $stems<thinə>.label(VerbStem), 'eat', 'a verbal word selects the verb sense';
is $stems<thinə>.label(NominalStem), 'food', 'and a nominal word the noun sense';

# Nothing chose, so nothing is chosen for it. A gloss that picked silently here
# would be inventing the answer rather than reporting that the language has not
# given one.
is $stems<thinə>.label(Host), 'food/eat',
    'with no host to go on, both senses are shown rather than one guessed';

is $stems<mirire>.label(VerbStem), 'teacher',
    'a stem with one sense ignores a host that disagrees';

# ------------------------------------------------------------------- a word ---

my $teach = gloss-word(
    $script, $morphology,
    parse-word($lexicon, $morphology, 'demirime'),
    $tables,
);

is $teach.form, 'de-miri-me', 'a word is rewritten with its boundaries shown';
is $teach.line, 'IMP-teach-PRS', 'against one label per morpheme';
ok $teach.complete, 'and nothing in it went unglossed';

# Leipzig's structural rule, and the one worth a test rather than an eye: the
# two lines must have the same number of pieces or they cannot be read against
# each other at all.
is $teach.form.comb('-').elems, $teach.line.comb('-').elems,
    'the object line and the gloss line have the same number of hyphens';

# ------------------------------------------------------------- the sentence ---

my $who = gloss-sentence($script, $lexicon, $morphology, 'Nari toro?');

is $who.form, 'na-ri toro', 'a sentence glosses word by word';

# `who`, not `Q-person`. `toro` is a word the lexicon defines before it is the
# question marker on "person", and Kevin's ruling is that both are true and the
# defined word is how people say it. `Ronosathwasha::ParseResult` still reports
# the derivation, as `Ambiguous` carrying both divisions.
is $who.line, 'you-SBJ who', 'preferring the word the lexicon defines';

is $who.aligned, "na-ri    toro\nyou-SBJ  who",
    'and the columns line up, which is what interlinear means';

# The three lines used to disagree with each other: the gloss line decomposed
# `toro` and the translation line, built from the reading, called it "who".
# Preferring the defined word makes them say the same thing.
#
# `declarative` stood here until the question scope arrived, and `e0662af` recorded
# it as known and wrong at the time: the question lives inside `toro` and nothing
# marked the clause, so the reader saw no marker anywhere and called the sentence a
# statement. This assertion is the one that would have caught it, and it was written
# to match the behaviour rather than the meaning. Then `interrogative` stood here,
# which was true and said less: where the question landed is the scope's whole
# cargo, and a line that dropped it would be `023`'s bug in this module's clothes.
is $who.translation.render, '[who: questions the predicate, timeless]',
    'and the gloss line and the translation line now name it the same way';

# The three arrangements render as three different lines, which is the point:
# `interrogative` flattened them into one.
is gloss-sentence($script, $lexicon, $morphology, 'Tororu thinəme?').translation.render,
    '[eat: questions the subject, present simple]',
    'a questioned subject says so in the bracketed line';

is gloss-sentence($script, $lexicon, $morphology, 'Tomwuyu thinəme?').translation.render,
    '[eat: questions the object, present simple]',
    'and a questioned object says which is different';

# The productive division is still what happens when the lexicon has no word for
# the whole thing, which is the case the question marker was declared for.
is gloss-sentence($script, $lexicon, $morphology, 'Nari tethinəme?').words.tail.line,
    'Q-eat-PRS', 'a word the lexicon does not list is still divided productively';

my $which-teacher = gloss-sentence(
    $script, $lexicon, $morphology, 'Twemirireri mirime?'
);
is $which-teacher.words.head.form, 'twe-mirire-ri',
    'the selective question exposes its three morphemes';
is $which-teacher.words.head.line, 'Q.SEL-teacher-SBJ',
    'with the selective Leipzig label rather than the open Q';
is $which-teacher.translation.render,
    '[teach: selectively questions the subject, present simple]',
    'and the reading summary preserves the discourse-linked distinction';

# The trailing `?` is punctuation and not a morpheme, so it must not reach the
# parser. `read-sentence` strips the same set for the same reason.
ok $who.words.tail.complete, 'punctuation does not become an unglossed piece';

# ------------------------------------------------------------ an open stem ---

my $named = gloss-sentence($script, $lexicon, $morphology, 'Laari mirime.');

is $named.words.head.line, UNGLOSSED,
    'a name the lexicon does not list glosses as a question mark';
nok $named.complete, 'and the sentence reports itself incomplete';
is $named.words.tail.line, 'teach-PRS',
    'while the rest of the sentence is glossed normally';

# --------------------------------------------------- nothing here is invented ---
#
# The check that matters, and the analogue of `t/25`'s. Every label a gloss line
# can produce must come from a declaration: a morpheme's `gloss` field, a
# lexicon entry reduced by `short-gloss`, or the marker for no answer at all.
# A table of labels written into `Gloss.rakumod` would pass every test above and
# fail this one.

my $declared = (
    $morphology.morphemes.map(*.gloss),
    $stems.values.map({ .nominal, .verbal }),
    UNGLOSSED,
).flat.grep(*.defined).Set;

my @sentences = <
    Nari|toro? Sheri|tomwu? Layi|demirime. Nari|tethinəme?
    Lari|mirireswe. Shoru|tomwuswo? Laari|mirime.
>.map(*.subst('|', ' ', :g));

my @invented = @sentences.map(-> $s {
    gloss-sentence($script, $lexicon, $morphology, $s).line.split(/<[\-\s]>/).Slip
}).grep({ .chars and not $declared{$_} });

is-deeply @invented.List, (),
    'every label in every gloss traces back to a declaration';

# ------------------------------------------------------- the third line ---
#
# Leipzig's free translation. It has two shapes on purpose: quoted when the
# corpus says so in Kevin's own words, bracketed when this module assembled it
# from the reading. A reader who cannot tell them apart will trust the wrong one.

my $corpus = load-utterances($data.add('utterances.toml'));

my $attested = gloss-sentence($script, $lexicon, $morphology, 'Sho thinəme.', :$corpus);

is $attested.translation.source, FromCorpus,
    'a sentence the corpus holds takes its translation from there';
is $attested.translation.render, q{'(I) eat that food (over there)'},
    'and renders in single quotes, which is what Leipzig means by a free translation';

my $threat = gloss-sentence(
    $script, $lexicon, $morphology,
    'Nasa tari thətaswethe luru lari yayi thwame.',
    :$corpus,
);

is $threat.translation.source, FromCorpus,
    'a coordinated utterance also takes its translation from the corpus';
is $threat.translation.render,
    q{'Your house will be a fire elemental's house, and I like it.'},
    'the accepted threat survives as fluent English rather than an assembled gloss';

my $unsourced-threat = gloss-sentence(
    $script, $lexicon, $morphology,
    'Nasa tari thətaswethe luru lari yayi thwame.',
);

is $unsourced-threat.translation.source, FromReading,
    'without the corpus, coordination still falls back to both typed readings';

# The same sentence with no corpus passed. Nothing is invented to fill the gap:
# the reading is reported instead, and it is punctuated so it cannot be mistaken
# for something somebody wrote.
my $unsourced = gloss-sentence($script, $lexicon, $morphology, 'Sho thinəme.');

is $unsourced.translation.source, FromReading,
    'without a corpus the same sentence falls back to its reading';
is $unsourced.translation.render, '[eat: declarative, present simple, distal]',
    'rendered in brackets, and glossing the stem the way the gloss line did';

# ------------------------------------------------- the sense a word selects ---
#
# The defect this closes. `thinəme` used to gloss as `food-PRS`: the noun entry
# won because it is listed directly, even though the tense on the word had
# already said the predicate was meant.

is gloss-sentence($script, $lexicon, $morphology, 'Sho thinəme.').words.tail.line,
    'eat-PRS', 'a tense selects the verbal sense of a two-sense stem';

is gloss-sentence($script, $lexicon, $morphology, 'Thinəyi twame.').words.head.line,
    'food-OBJ', 'and a case marker selects the nominal one';

# The other half of the same rule, in the parser rather than here: `swe` has two
# claimants and the stem settles it.
is gloss-sentence($script, $lexicon, $morphology, 'Lari mirireswe.').words.tail.line,
    'teacher-COP', 'swe on a noun glosses as the copularizer, not the infinitive';

# Zero-marked features are absent from the language and must be absent here.
# Printing "affirmative" would report a choice nobody wrote a morpheme for.
nok $unsourced.translation.text.contains('affirmative'),
    'an unmarked polarity is not reported';
nok $unsourced.translation.text.contains('asserted'),
    'and neither is an unmarked modality';

my $negated = gloss-sentence($script, $lexicon, $morphology, 'Mirireri mothinəme.');

ok $negated.translation.text.contains('negative'),
    'while a polarity that was written does appear';

# A sentence the reader cannot read says why. "[no reading]" on its own is the
# least useful thing this line could carry, since the reason somebody glosses a
# sentence they have just written is to find out what is wrong with it.
my $unread = gloss-sentence($script, $lexicon, $morphology, 'Laari mirime.', :$corpus);

is $unread.translation.source, Unavailable,
    'a sentence with no reading and no corpus entry has no translation';
ok $unread.translation.render.contains('laari'),
    'and the line names the word that defeated the reader';

is $unread.render.lines.elems, 3,
    'every rendering is three lines, which is what interlinear means';
