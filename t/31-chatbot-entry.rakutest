use Test;

use Ronosathwasha::Chatbot;

plan 21;

my IO::Path $script = repository-root.add('bin/ronosathwasha-chat');

my $help = run $*EXECUTABLE, $script, '--help', :out, :err;
my Str $help-out = $help.out.slurp;
my Str $help-err = $help.err.slurp;

is $help.exitcode, 0, 'the entry point has a model-free help path';
like $help-out, /'make chat'/, 'help names the make target';
ok $help-out.contains('--session=PATH'), 'help names the session option';
ok $help-out.contains('/evidence'), 'help names the evidence command';
ok $help-out.contains('/budget'), 'help names the budget command';
ok $help-out.contains('/parse'), 'help names the parse command';
ok $help-out.contains('/gaps'), 'help names the gaps command';
ok $help-out.contains('/export PATH'), 'help names the export command';
ok $help-out.contains('/quit'), 'help names the quit command';
like $help-out, /'llama-server'/, 'help names the external server prerequisite';
is $help-err, '', 'help does not write diagnostics';

my IO::Path $legacy = repository-root.add('scripts/chatbot.raku');
my $legacy-help = run $*EXECUTABLE, $legacy, '--help', :out, :err;
my Str $legacy-out = $legacy-help.out.slurp;

is $legacy-help.exitcode, 0,
    'the legacy script keeps a model-free help path';
like $legacy-out, /'--session=PATH'/,
    'the legacy script exposes the durable session option';
like $legacy-out, /'/budget'/,
    'the legacy script exposes the current terminal commands';

my $dry-run = run 'make', '-n', 'chat', :out, :err;
my Str $make-out = $dry-run.out.slurp;

is $dry-run.exitcode, 0, 'make knows the chat target';
ok $make-out.contains('bin/ronosathwasha-chat'), 'the target invokes the executable script';

my $whole-run = run 'make', '-n', 'chat-all', :out, :err;
my Str $whole-out = $whole-run.out.slurp;

is $whole-run.exitcode, 0, 'make knows the all-in-one chat target';
ok $whole-out.contains('llama-server'), 'the all-in-one target starts the model server';
ok $whole-out.contains('--jinja'), 'the all-in-one target uses the model chat template';
ok $whole-out.contains('/health'), 'the all-in-one target waits for server readiness';
ok $whole-out.contains('bin/ronosathwasha-chat'),
    'the all-in-one target starts the conversation after the server';
