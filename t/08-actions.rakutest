use Test;

use Ronosathwasha::Chatbot;
use Ronosathwasha::Types;
use Ronosathwasha::Script;
use Ronosathwasha::Lexicon;
use Ronosathwasha::Morphology;
use Ronosathwasha::Semantics;
use Ronosathwasha::Actions;

my IO::Path $data = repository-root.add('data');
my $script     = load-script($data.add('script.toml'));
my $lexicon    = load-lexicon($data.add('lexicon.toml'));
my $morphology = load-morphology($data.add('morphology.toml'));
my $corpus     = load-utterances($data.add('utterances.toml'));

# One test per corpus sentence, plus the checks below.
plan $corpus.utterances.elems + 41;

sub read(Str $s) { read-sentence($script, $lexicon, $morphology, $s) }

# --------------------------------------------------- the corpus, sentence by sentence ---
#
# The strongest assertion available: every sentence Kevin declared the meaning
# of is read back to the same meaning by the grammar. The corpus states it and
# the code derives it, independently.

for $corpus.utterances -> $declared {
    my $outcome = read($declared.text);

    subtest "{ $declared.text } means what it is declared to mean" => {
        plan 9;

        isa-ok $outcome, Understood, 'it is understood at all';

        my $got = $outcome ~~ Understood ?? $outcome.reading !! Reading;

        is $got.speech-act, $declared.speech-act, 'speech act';
        is $got.predicate,  $declared.predicate,  'predicate';
        is $got.tense,      $declared.tense,      'tense';
        is $got.aspect,     $declared.aspect,     'aspect';
        is $got.polarity,   $declared.polarity,   'polarity';
        is $got.modality,   $declared.modality,   'modality';

        # The axis review 026 found missing: every older one was compared and
        # the newest was not, so a corpus entry could declare a scope the
        # reader disagreed with and stay green.
        is $got.question-scope, $declared.question-scope, 'question scope';

        is-deeply $got.arguments.sort.List, $declared.arguments.sort.List, 'arguments';
    }
}

# ------------------------------------------------------- the predicate is found ---

my $wants = read('Thinəswe twame').reading;
is $wants.predicate, 'twa',
    'the verb is the word carrying tense, not the last word';

my $eats = read('Sho thinəme').reading;
is $eats.predicate, 'thinə',
    'nor the first, when a demonstrative opens the sentence';

# ----------------------------------------------------------- deixis from vowels ---
#
# Never declared anywhere. Decision 9 put the three demonstratives on front,
# central and back vowels, and this reads the distance back out of the script.

is read('Sho thinəme').reading.reference, Distal,   'back o is far';
is read('Lari sha lithinəme').reading.reference, Medial, 'central a is middle';
is read('She thinəme').reading.reference, Proximal, 'front e is near';

# ------------------------------------------------------------------ the extras ---

is read('Lari taði medime').reading.locative, 'locative-towards',
    'the locative particle is reported by identity';

ok read('Lari thinəmedi').reading.ambiguous.elems,
    'an ambiguous word is used and recorded rather than silently resolved';

nok read('Lari thinəme').reading.ambiguous.elems,
    'while an unambiguous sentence records none';

# ----------------------------------------------------------------- not understood ---

my $nope = read('Lari thothinəme');
isa-ok $nope, NotUnderstood, 'a retired form stops the sentence being understood';

# ------------------------------------------------------------------- decision 17 ---
#
# The verb is fixed and everything before it is free, because the particles say
# what each constituent is and no particle identifies the verb.

isa-ok read('layi Mirireri mirimedi'), Understood,
    'a subject and object may swap, since their particles carry the roles';

is-deeply read('layi Mirireri mirimedi').reading.arguments.sort.List,
          read('Mirireri layi mirimedi').reading.arguments.sort.List,
    'and the sentence means the same either way';

my $backwards = read('mirimedi Mirireri layi');
isa-ok $backwards, WrongOrder, 'but the verb may not leave the end';
is $backwards.verb, 'mirimedi', 'and the offending word is named';

# ---------------------------------------------------------- decision 22 ---

my $formal-name = read('Lasa dələri Laariswe.');
isa-ok $formal-name, Understood, 'a formal copular introduction is understood';
is $formal-name.reading.predicate, 'laari', 'the open name is its predicate';
ok $formal-name.reading.nominal-predicate, 'the predicate is nominal';
ok $formal-name.reading.explicit-copula, 'the written copularizer is preserved';
nok $formal-name.reading.tense.defined, 'the bare copularizer does not assert a time';

my $ordinary-name = read('Dələri Laari.');
isa-ok $ordinary-name, Understood, 'ordinary speech may omit the copularizer';
is $ordinary-name.reading.predicate, 'laari', 'the final open nominal supplies the identity';
nok $ordinary-name.reading.explicit-copula, 'the omitted copula remains omitted';
nok $ordinary-name.reading.tense.defined, 'zero copula is likewise timeless';

my $present-name = read('Lasa dələri Laarisweme.');
isa-ok $present-name, Understood, 'the copularizer may carry explicit tense';
is $present-name.reading.tense, Present, 'the written tense is interpreted';
ok $present-name.reading.tense.defined, 'and its contrastive presence is preserved';

my $classification = read('Dələri runəswo.');
isa-ok $classification, Understood, 'a declared noun may also become a predicate';
is $classification.reading.predicate, 'runə', 'the noun is recovered beneath the copularizer';
ok $classification.reading.nominal-predicate, 'and is distinguished from an infinitive';

my $present-classification = read('Dələri runəswomo.');
isa-ok $present-classification, Understood, 'a declared nominal predicate may carry tense';
ok $present-classification.reading.nominal-predicate,
    'the shared form is not misread as an infinitive before tense';
ok $present-classification.reading.tense.defined,
    'its written present remains explicit';

isa-ok read('Lari nu thinəme.'), NotUnderstood,
    'an open-looking word in a verbal clause remains unknown';
isa-ok read('Laari.'), NotUnderstood,
    'a bare unknown form is not assumed to be a name without clause structure';

# ---------------------------------------------- the question is found anywhere ---
#
# `to-`/`te-` attaches to whichever constituent is being asked about, and this used
# to be read off the predicate alone. Everything below reported `Declarative`
# before the question scope arrived, and `Nari toro?` is the case `e0662af`
# recorded as known and wrong: the question lives inside the word, so no prefix
# existed anywhere for the old rule to see.

sub asked(Str $sentence) {
    my $outcome = read($sentence);

    $outcome ~~ Understood ?? $outcome.reading !! Nil;
}

my $lexicalised = asked('Nari toro?');
is $lexicalised.speech-act, Interrogative,
    'a lexicalised interrogative makes its clause a question';
is $lexicalised.question-scope, QuestionsPredicate,
    'and `toro` is the predicate, so that is what is asked about';

is asked('Nari tethinəme?').question-scope, QuestionsPredicate,
    'the productive prefix on a verb scopes the same way';

is asked('Tororu thinəme?').question-scope, QuestionsSubject,
    'the subject particle says a questioned subject';
is asked('Tomwuyu thinəme?').question-scope, QuestionsObject,
    'and the object particle says a questioned object';

# Decision 17 frees every position before the verb, so a bare questioned word is
# grammatical and has no role these types can name. Recorded rather than guessed
# at: `Sho thinəme.` is the declarative precedent, and the corpus states its
# arguments as empty for the same reason.
is asked('Toro thinəme?').question-scope, QuestionsUnmarkedConstituent,
    'a questioned word with no particle is named as exactly that';

# `tono` is a listed word beginning with `to` and is not a question, which is why
# the check is the `[interrogative]` section rather than the prefix's spelling.
nok asked('Lari tonoyu thinəme.').question-scope.defined,
    'a word that merely starts with `to` asks nothing';

nok asked('Lari thinəme.').question-scope.defined,
    'and a statement carries no scope at all';
