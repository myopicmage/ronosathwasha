#!/usr/bin/env raku

=begin pod

=head1 NAME

ronosathwasha-chat - start the local Ronosathwasha conversation

=head1 SYNOPSIS

    bin/ronosathwasha-chat --help
    bin/ronosathwasha-chat [--session=PATH]

=head1 PREREQUISITES

C<llama-server> must already be running at the URL in
C<config/chatbot.toml>. The model weights stay outside this repository.

=end pod

use lib $?FILE.IO.parent.parent.add('lib').Str;

use Ronosathwasha::App;
use Ronosathwasha::Chatbot;
use Ronosathwasha::Commands;

#| The slash commands are rendered from C<Ronosathwasha::Commands> rather than
#| repeated, because a second copy of the list is a second thing to forget.
#|
#| They are also separated from the invocation flags, which the previous single
#| column implied were interchangeable. C<--session> is passed to start a
#| session and C</budget> is typed inside one, and running them together read as
#| though either would work in either place.
sub usage(--> Str) {
    my Str $commands = command-help();

    qq:to/USAGE/.trim;
    Ronosathwasha local conversation

      make chat            start Lauri's terminal conversation
      --session=PATH       store the session at PATH

    Once the conversation is running:

    { $commands }

    The command expects llama-server at the configured URL. It does not start
    the server or copy model weights into the repository.
    USAGE
}

sub MAIN(
    Bool :$help = False,
    Str  :$session = 'sessions/chat.jsonl',
) {
    if $help {
        say usage;
        return;
    }

    my IO::Path $root = repository-root;
    my IO::Path $session-path = $session.IO.is-absolute
        ?? $session.IO
        !! $root.add($session);

    load-app($root, $session-path).run;
}
